        "template": "Quince by Zabbix agent",
        "name": "Quince by Zabbix agent",
        "description": "Quince Audio Logger. Local Agent UserParameter reads a cached snapshot. See zabbix/README.md. Forecast percentage matches the channel card (0-100); it is not disk fullness.",
        "groups": [
          {
            "name": "Templates/Quince"
          }
        ],
        "tags": [
          {
            "tag": "application",
            "value": "quince"
          }
        ],
        "items": [
          {
            "uuid": "0ae92ccb588d4b42955a8f06b6857216",
            "name": "Quince: Снимок мониторинга",
            "type": "ZABBIX_PASSIVE",
            "key": "quince.monitoring.get",
            "delay": "30s",
            "history": "0",
            "value_type": "TEXT",
            "trends": "0",
            "preprocessing": [
              {
                "type": "JAVASCRIPT",
                "parameters": [
                  "var d = JSON.parse(value); if (d.schema_version !== 1 || !Array.isArray(d.channels) || typeof d.generated_at !== \"number\") { throw \"Invalid Quince snapshot\"; } return value;"
                ]
              }
            ],
            "tags": [
              {
                "tag": "application",
                "value": "quince"
              }
            ]
          },
          {
            "uuid": "685d6305847f4e8dad2fefc006135bf8",
            "name": "Quince: Время снимка",
            "type": "DEPENDENT",
            "key": "quince.monitoring.timestamp",
            "delay": "0",
            "history": "7d",
            "value_type": "UNSIGNED",
            "trends": "90d",
            "preprocessing": [
              {
                "type": "JSONPATH",
                "parameters": [
                  "$.generated_at"
                ]
              }
            ],
            "master_item": {
              "key": "quince.monitoring.get"
            },
            "tags": [
              {
                "tag": "application",
                "value": "quince"
              }
            ],
            "units": "unixtime",
            "triggers": [
              {
                "uuid": "cba8fc7e1dbf440eb4de17803c566ef5",
                "name": "Quince: Данные мониторинга отсутствуют или устарели",
                "expression": "nodata(/Quince by Zabbix agent/quince.monitoring.timestamp,{$QUINCE.NODATA})=1 or fuzzytime(/Quince by Zabbix agent/quince.monitoring.timestamp,{$QUINCE.NODATA})=0",
                "priority": "HIGH",
                "tags": [
                  {
                    "tag": "application",
                    "value": "quince"
                  }
                ]
              }
            ]
          },
          {
            "uuid": "3168721cf96c414ab17d99369ab52801",
