                "type": "JSONPATH",
                "parameters": [
                  "$.channels"
                ]
              },
              {
                "type": "JAVASCRIPT",
                "parameters": [
                  "return JSON.stringify(JSON.parse(value).map(function(c) { return {id:c.id,name:c.name,source_type:c.source_type}; }));"
                ]
              },
              {
                "type": "DISCARD_UNCHANGED_HEARTBEAT",
                "parameters": [
                  "1h"
                ]
              }
