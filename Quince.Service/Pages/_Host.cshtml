@page "/"
@namespace Quince.Service.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Quince.Service.Services
@using Quince.Service.Services.Auth
@inject AuthService Auth
@inject AppSettingsService AppSettings
@{
    Layout = null;
    var authRequired = Auth.AuthRequired;
    var username = HttpContext.Items["Username"] as string;
    var isAdmin = HttpContext.Items["IsAdmin"] as bool? ?? false;
    var developSuffix = AppSettings.Current.Develop ? " отладочная версия" : "";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Айва v@(Quince.Service.VersionInfo.Version)@(developSuffix)</title>
    <base href="~/" />
    <link rel="icon" type="image/svg+xml" href="icon.svg" />
    <link href="app.css" rel="stylesheet" />
    <script>
        // Applies the saved theme before first paint so the page never flashes light-then-dark
        // (or vice versa) — runs synchronously, ahead of app.css's own :root default.
        (function () {
            try {
                var t = localStorage.getItem('quince-theme');
                if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
            } catch (e) { }
        })();
    </script>
</head>
<body>
    <div id="components-reconnect-modal">⚠️ Переподключение к серверу…</div>
    <component type="typeof(App)" render-mode="ServerPrerendered"
                param-AuthRequired="@authRequired" param-Username="@username" param-IsAdmin="@isAdmin" />
    <script src="_framework/blazor.server.js" autostart="false"></script>
    <script src="goniometer.js"></script>
    <script src="playback.js"></script>
    <script src="auth.js"></script>
    <script src="theme.js"></script>
    <script src="dialogs.js"></script>
    <script src="columnResize.js"></script>
    <script src="reconnect.js"></script>
</body>
</html>
