@page "/"
@using Quince.Service.Configuration
@using Quince.Service.Services
@inject ChannelManager ChannelManager
@inject ChannelUiState UiState
@inject LocalizationService Loc
@implements IDisposable

<div class="list-toolbar">
    <div class="filter-row">
        <input @bind="FilterText" @bind:event="oninput" placeholder="@Loc["index.filterPlaceholder"]"
               title="@Loc["index.filterTitle"]" />
    </div>

    @if (!string.IsNullOrEmpty(UiState.StatusMessage))
    {
        <div class="status-bar">
            <span>@UiState.StatusMessage</span>
            <button type="button" class="status-bar-close" @onclick="UiState.ClearStatusMessage" title="@Loc["index.statusHideTitle"]">✕</button>
        </div>
    }
</div>

<div class="channel-scroll">
    @if (!FilteredChannels.Any())
    {
        <p class="empty-state">
            @if (!ChannelManager.Channels.Any())
            {
                <text>@Loc["index.emptyNoChannels"]</text>
            }
            else
            {
                <text>@Loc.T("index.emptyFiltered", FilterText)</text>
            }
        </p>
    }
    else
    {
        <div class="channel-list">
            @foreach (var ch in FilteredChannels)
            {
                <ChannelCard @key="ch.Filename" Config="ch" />
            }
        </div>
    }
</div>

<div class="app-footer">@Loc.T("index.footerCount", ChannelManager.Channels.Count)</div>

@code {
    private string FilterText { get; set; } = "";

    private IEnumerable<ChannelConfig> FilteredChannels =>
        ChannelManager.Channels.Where(c =>
            string.IsNullOrWhiteSpace(FilterText) ||
            c.Name.Contains(FilterText, StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized()
    {
        ChannelManager.ChannelAdded += OnChannelsChanged;
        ChannelManager.ChannelUpdated += OnChannelUpdated;
        ChannelManager.ChannelRemoved += OnChannelsChanged;
        UiState.Changed += OnUiStateChanged;
        Loc.Changed += OnUiStateChanged;
    }

    private void OnChannelsChanged(ChannelConfig config) => InvokeAsync(StateHasChanged);

    private void OnChannelUpdated(ChannelConfig oldConfig, ChannelConfig newConfig) => InvokeAsync(StateHasChanged);

    private void OnUiStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ChannelManager.ChannelAdded -= OnChannelsChanged;
        ChannelManager.ChannelUpdated -= OnChannelUpdated;
        ChannelManager.ChannelRemoved -= OnChannelsChanged;
        UiState.Changed -= OnUiStateChanged;
        Loc.Changed -= OnUiStateChanged;
    }
}
