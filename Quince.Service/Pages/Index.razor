@page "/"
@using Quince.Service.Audio
@using Quince.Service.Configuration
@using Quince.Service.Services
@inject ChannelManager ChannelManager
@inject AudioEngineManager EngineManager
@inject ChannelUiState UiState
@inject LocalizationService Loc
@inject AppSettingsService AppSettings
@implements IDisposable

<div class="list-toolbar">
    <div class="filter-row">
        <input @bind="FilterText" @bind:event="oninput" placeholder="@Loc["index.filterPlaceholder"]"
               title="@Loc["index.filterTitle"]" />
    </div>

    <button type="button" class="dialog-tab filter-cycle-btn @RunStateFilterCssClass"
            title="@Loc["index.runStateFilterTitle"]" @onclick="CycleRunStateFilter">
        @Loc["index.runStateFilterLabel"] @RunStateFilterValueLabel
    </button>

    <button type="button" class="dialog-tab filter-cycle-btn @MetadataFilterCssClass"
            title="@Loc["index.metadataFilterTitle"]" @onclick="CycleMetadataFilter">
        @Loc["index.metadataFilterLabel"] @MetadataFilterValueLabel
    </button>

    @if (UiState.BulkSelectMode)
    {
        <div class="status-bar bulk-edit-bar">
            <button type="button" class="btn btn-small" @onclick="SelectAllFiltered">@Loc["index.bulkSelectAll"]</button>
            <button type="button" class="btn btn-small" @onclick="UiState.DeselectAll">@Loc["index.bulkDeselectAll"]</button>
            <button type="button" class="btn btn-start" disabled="@(UiState.SelectedChannelFilenames.Count == 0)"
                    title="@Loc["index.bulkEditButtonTitle"]" @onclick="UiState.OpenBulkEdit">
                @Loc["index.bulkEditButton"]
            </button>
        </div>
    }
    else if (!string.IsNullOrEmpty(UiState.StatusMessage))
    {
        <div class="status-bar">
            <span>@UiState.StatusMessage</span>
            <button type="button" class="status-bar-close" @onclick="UiState.ClearStatusMessage" title="@Loc["index.statusHideTitle"]">✕</button>
        </div>
    }
</div>

<div class="channel-scroll">
    @if (!FilteredChannels.Any())
    {
        <p class="empty-state">
            @if (!ChannelManager.Channels.Any())
            {
                <text>@Loc["index.emptyNoChannels"]</text>
            }
            else
            {
                <text>@Loc.T("index.emptyFiltered", FilterText)</text>
            }
        </p>
    }
    else
    {
        <div class="channel-list @(AppSettings.Current.CompactLayout ? "channel-list-compact" : "")">
            @foreach (var ch in FilteredChannels)
            {
                <ChannelCard @key="ch.Filename" Config="ch" />
            }
        </div>
    }
</div>

<div class="app-footer">@Loc.T("index.footerCount", ChannelManager.Channels.Count)</div>

@code {
    private string FilterText { get; set; } = "";

    // "Тишина" isn't one of ChannelRunState's 3 values (that enum deliberately mirrors only the
    // recording-status dot, see ChannelDisplayFormatter) — it reflects the separate "Звук" indicator
    // (EngineStatus.IsSilent) instead, so this filter gets its own page-local option type rather than
    // extending ChannelRunState and risking that dot's classification drifting from what it actually shows.
    private enum StatusFilterOption { All, Running, Stopped, Error, Silent }

    // Cycle order for the "Статус" button: Все → Running → Stopped → Error → Тишина → back to Все.
    private static readonly StatusFilterOption[] RunStateCycle =
        { StatusFilterOption.All, StatusFilterOption.Running, StatusFilterOption.Stopped, StatusFilterOption.Error, StatusFilterOption.Silent };

    private enum MetadataFilterOption { All, Errors, Missing }

    // Cycle order for the "Метаданные" button: All → Errors → Missing → back to All.
    private static readonly MetadataFilterOption[] MetadataFilterCycle =
        { MetadataFilterOption.All, MetadataFilterOption.Errors, MetadataFilterOption.Missing };

    private StatusFilterOption _runStateFilter = StatusFilterOption.All;
    private MetadataFilterOption _metadataFilter = MetadataFilterOption.All;

    private string RunStateFilterValueLabel => _runStateFilter switch
    {
        StatusFilterOption.All => Loc["index.filterAll"],
        StatusFilterOption.Running => Loc["index.filterRunning"],
        StatusFilterOption.Stopped => Loc["index.filterStopped"],
        StatusFilterOption.Error => Loc["index.filterError"],
        StatusFilterOption.Silent => Loc["index.filterSilent"],
        _ => "",
    };

    private string MetadataFilterValueLabel => _metadataFilter switch
    {
        MetadataFilterOption.Errors => Loc["index.metadataFilterErrors"],
        MetadataFilterOption.Missing => Loc["index.metadataFilterMissing"],
        _ => Loc["index.filterAll"],
    };

    // Background tint reflects the currently selected value (not just "is a filter active"), so the
    // button's own color already tells you what it's set to at a glance.
    private string RunStateFilterCssClass => _runStateFilter switch
    {
        StatusFilterOption.All => "filter-state-all",
        StatusFilterOption.Running => "filter-state-running",
        StatusFilterOption.Stopped => "filter-state-stopped",
        StatusFilterOption.Error => "filter-state-error",
        StatusFilterOption.Silent => "filter-state-silent",
        _ => "filter-state-all",
    };

    private string MetadataFilterCssClass => _metadataFilter switch
    {
        MetadataFilterOption.Errors => "filter-state-errors",
        MetadataFilterOption.Missing => "filter-state-missing",
        _ => "filter-state-all",
    };

    private void CycleRunStateFilter()
    {
        var index = Array.IndexOf(RunStateCycle, _runStateFilter);
        _runStateFilter = RunStateCycle[(index + 1) % RunStateCycle.Length];
        StateHasChanged();
    }

    private void CycleMetadataFilter()
    {
        var index = Array.IndexOf(MetadataFilterCycle, _metadataFilter);
        _metadataFilter = MetadataFilterCycle[(index + 1) % MetadataFilterCycle.Length];
        StateHasChanged();
    }

    private IEnumerable<ChannelConfig> FilteredChannels =>
        ChannelManager.Channels.Where(c =>
            (string.IsNullOrWhiteSpace(FilterText) ||
             c.Name.Contains(FilterText, StringComparison.OrdinalIgnoreCase)) &&
            MatchesRunStateFilter(c) &&
            MatchesMetadataFilter(c));

    private bool MatchesRunStateFilter(ChannelConfig c)
    {
        if (_runStateFilter == StatusFilterOption.All) return true;
        var status = EngineManager.GetStatus(c.Name) ?? new EngineStatus();
        if (_runStateFilter == StatusFilterOption.Silent) return status.IsSilent;

        var runState = ChannelDisplayFormatter.ClassifyRunState(status);
        return _runStateFilter switch
        {
            StatusFilterOption.Running => runState == ChannelRunState.Running,
            StatusFilterOption.Stopped => runState == ChannelRunState.Stopped,
            StatusFilterOption.Error => runState == ChannelRunState.Error,
            _ => true,
        };
    }

    private bool MatchesMetadataFilter(ChannelConfig c)
    {
        if (_metadataFilter == MetadataFilterOption.All) return true;
        var status = EngineManager.GetStatus(c.Name) ?? new EngineStatus();
        return _metadataFilter switch
        {
            MetadataFilterOption.Errors => status.MetadataOk == false,
            MetadataFilterOption.Missing => status.MetadataOk == null,
            _ => true,
        };
    }

    // Selects only the currently filtered/visible channels, not every channel in the app — matches
    // what the user can actually see on screen while the name/status/metadata filters are active.
    private void SelectAllFiltered() => UiState.SelectAll(FilteredChannels.Select(c => c.Filename));

    protected override void OnInitialized()
    {
        ChannelManager.ChannelAdded += OnChannelsChanged;
        ChannelManager.ChannelUpdated += OnChannelUpdated;
        ChannelManager.ChannelRemoved += OnChannelsChanged;
        UiState.Changed += OnUiStateChanged;
        Loc.Changed += OnUiStateChanged;
        AppSettings.Changed += OnUiStateChanged;
        EngineManager.StatusUpdated += OnEngineStatusUpdated;
    }

    private void OnChannelsChanged(ChannelConfig config) => InvokeAsync(StateHasChanged);

    private void OnChannelUpdated(ChannelConfig oldConfig, ChannelConfig newConfig) => InvokeAsync(StateHasChanged);

    private void OnUiStateChanged() => InvokeAsync(StateHasChanged);

    // Unlike ChannelCard's own per-card, name-scoped subscription, this list's filtered view can
    // depend on ANY channel's status changing (not just one), so every StatusUpdated firing needs to
    // re-evaluate FilteredChannels — no channelName/status params to check here.
    private void OnEngineStatusUpdated(string channelName, EngineStatus status) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ChannelManager.ChannelAdded -= OnChannelsChanged;
        ChannelManager.ChannelUpdated -= OnChannelUpdated;
        ChannelManager.ChannelRemoved -= OnChannelsChanged;
        UiState.Changed -= OnUiStateChanged;
        Loc.Changed -= OnUiStateChanged;
        AppSettings.Changed -= OnUiStateChanged;
        EngineManager.StatusUpdated -= OnEngineStatusUpdated;
    }
}
