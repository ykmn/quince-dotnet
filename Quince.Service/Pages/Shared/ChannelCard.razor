@using System.Globalization
@using Microsoft.Extensions.Logging
@using Quince.Service.Configuration
@using Quince.Service.Services
@using Quince.Service.Audio
@inject AudioEngineManager EngineManager
@inject ChannelManager ChannelManager
@inject ChannelUiState UiState
@inject AppSettingsService AppSettings
@inject AudioPlaybackService PlaybackService
@inject LocalizationService Loc
@inject ILogger<ChannelCard> Log
@implements IAsyncDisposable

<div class="channel-card @StatusBorderClass">
    <div class="channel-row1">
        @if (UiState.BulkSelectMode)
        {
            <input type="checkbox" class="channel-select-checkbox" checked="@UiState.SelectedChannelFilenames.Contains(Config.Filename)"
                   @onchange="() => UiState.ToggleChannelSelected(Config.Filename)" title="@Loc["channelCard.bulkSelectTitle"]" />
        }
        <div class="status-dot @StatusDotClass" title="@StatusDotTitle"></div>
        @if (Config.Source.Type == "stream")
        {
            <div class="status-dot @MetadataDotClass" title="@MetadataDotTitle"></div>
        }
        @if (IsEligibleType)
        {
            <div class="status-dot @SoundDotClass" title="@SoundDotTitle"></div>
        }
        <div class="channel-name" title="@Config.Name">@Config.Name</div>
        @if (_status.ReconnectAttempt > 0)
        {
            <div class="reconnect-label">@Loc.T("channelCard.reconnectLabel", _status.ReconnectAttempt)</div>
        }
        <div class="spacer"></div>
        <button class="btn @(_status.IsFileRecording ? "btn-stop" : "btn-start")"
                title="@(_status.IsFileRecording ? Loc["channelCard.stopTitle"] : Loc["channelCard.startTitle"])"
                disabled="@(!IsEligibleType)"
                @onclick="ToggleRecording">
            @(_status.IsFileRecording ? Loc["channelCard.stop"] : Loc["channelCard.start"])
        </button>
        <button class="btn @(IsPlayingThis ? "btn-playback-stop" : "btn-small")" title="@(IsPlayingThis ? Loc["channelCard.stopPlaybackTitle"] : Loc["channelCard.playTitle"])"
                disabled="@(!IsEligibleType)"
                @onclick="TogglePlayback">
            @(IsPlayingThis ? "⏹" : "▶")
        </button>
        <button class="btn btn-small btn-sep" title="@Loc["channelCard.editTitle"]" @onclick="Edit">✎</button>
        <button class="btn btn-small" title="@Loc["channelCard.cloneTitle"]" @onclick="Clone">⧉</button>
        <button class="btn btn-meters btn-sep" title="@Loc["channelCard.metersTitle"]" @onclick="OpenIndicators">@Loc["channelCard.meters"]</button>
        <button class="btn btn-delete btn-sep" title="@Loc["channelCard.deleteTitle"]" @onclick="Delete">✕</button>
    </div>
    <div class="channel-info-row">
        <div class="channel-info-col">
            <div class="channel-row2" title="@Loc["channelCard.sourceTitle"]">
                <strong>@Loc["channelCard.sourceLabelPrefix"]</strong> @SourcePrefix@if (!string.IsNullOrEmpty(SourceUrl))
                {
                    <span class="maskable-value" title="@Loc["channelCard.clickToToggleMask"]" @onclick="UiState.ToggleValuesMasked">@(UiState.ValuesMasked ? MaskText(SourceUrl) : SourceUrl)</span>
                }
            </div>
            <div class="channel-row3" title="@Loc["channelCard.outputTitle"]">
                <strong>@Loc["channelCard.outputLabelPrefix"]</strong> @OutputFormatQuality@if (!string.IsNullOrEmpty(OutputPath))
                {
                    <text> · </text><span class="maskable-value" title="@Loc["channelCard.clickToToggleMask"]" @onclick="UiState.ToggleValuesMasked">@(UiState.ValuesMasked ? MaskText(OutputPath) : OutputPath)</span>
                }
                @if (!string.IsNullOrEmpty(OutputDuration))
                {
                    <text> · </text>@OutputDuration
                }
            </div>
            @if (HasMetadata)
            {
                <div class="channel-row-metadata" title="@MetadataDotTitle"><strong>@Loc["channelCard.metadataLabelPrefix"]</strong> @(_metadataText ?? Loc["channelCard.metadataNotFlowing"])</div>
            }
        </div>
        @if (AppSettings.Current.ShowTpIndicators)
        {
            <div class="level-widget" title="@Loc["channelCard.levelTitle"]">
                <div class="level-row">
                    <span class="level-label">TP</span>
                    <div class="level-track" style="background: @(TrackGradient);"><div class="level-cover" style="width: @(CoverPercentText)%;"></div></div>
                    <span class="level-value">@LevelValueText</span>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public ChannelConfig Config { get; set; } = null!;

    private EngineStatus _status = new();
    private LevelReading _level = new();
    private string? _metadataText;
    private bool _disposed;

    // Yellow whenever this channel is being listened to, regardless of whether it's also being
    // recorded to disk right now — listen-in always wins so the border reflects "you'll hear this"
    // rather than the recording state. Green while actually writing to disk (IsFileRecording, not
    // just IsRecording — a channel auto-started only for listen-in has IsRecording true but should
    // not look like it's recording) when not being listened to. Red once the channel stopped itself
    // after exhausting its reconnect-attempt budget (EngineStatus.HasError), until it's started again.
    private string StatusBorderClass => _status switch
    {
        _ when IsPlayingThis => "is-listening",
        { IsFileRecording: true } => "is-recording",
        { HasError: true } => "has-error",
        _ => "",
    };

    private string StatusDotClass => ChannelDisplayFormatter.ClassifyRunState(_status) switch
    {
        ChannelRunState.Running => "dot-green",
        ChannelRunState.Error => "dot-red",
        _ => "",
    };

    private string StatusDotTitle => _status switch
    {
        { IsRecording: true, ReconnectAttempt: > 0 } => Loc.T("channelCard.statusRecordingReconnect", _status.ReconnectAttempt),
        { IsRecording: true } => Loc["channelCard.statusRecording"],
        { HasError: true } => Loc["channelCard.statusError"],
        _ => Loc["channelCard.statusStopped"],
    };

    private bool HasMetadata => !string.IsNullOrEmpty(Config.Source.MetadataUrl);

    // Purple only while metadata is actively flowing right now — grey covers both "not configured"
    // and "configured but nothing detected (yet or at all)" alike, per the simplified indicator.
    private string MetadataDotClass => _status.MetadataOk == true ? "dot-purple" : "";
    private string MetadataDotTitle => (Config.Source.MetadataUrl, _status.MetadataOk) switch
    {
        ("", _) => Loc["channelCard.metadataNone"],
        (_, true) => Loc["channelCard.metadataFlowing"],
        _ => Loc["channelCard.metadataNotFlowing"],
    };

    // Green while sound is present, red during silence (SilenceDetector.OnSilence) or while actively
    // reconnecting (ReconnectAttempt > 0 — no audio is flowing at all, so SilenceDetector never even
    // runs to set IsSilent; without this case a channel stuck retrying a bad URL forever reads as
    // "sound present" by default), grey once the channel is stopped. Channels with the silence
    // detector disabled in config never see IsSilent flip to true, so a genuinely-connected channel
    // simply stays green while recording — same "nothing to flag" convention already used by the
    // metadata dot above.
    private string SoundDotClass => _status switch
    {
        { IsRecording: false } => "",
        { IsSilent: true } or { ReconnectAttempt: > 0 } => "dot-red",
        _ => "dot-green",
    };

    private string SoundDotTitle => _status switch
    {
        { IsRecording: false } => Loc["channelCard.statusStopped"],
        { ReconnectAttempt: > 0 } => Loc["channelCard.soundNoConnection"],
        { IsSilent: true } => Loc["channelCard.soundSilence"],
        _ => Loc["channelCard.soundPresent"],
    };

    private bool IsEligibleType => Config.Source.Type is "stream" or "soundcard" or "livewire";

    private string LevelValueText => double.IsNegativeInfinity(_level.TruePeakDb)
        ? "—"
        : _level.TruePeakDb.ToString("F1", CultureInfo.InvariantCulture) + " dB";

    private string TrackGradient => MeterZoneStyle.BuildTrackGradient(AppSettings.Current.MeterColors, vertical: false);

    // CSS numbers must use '.' as the decimal separator regardless of server locale — a raw
    // interpolated double here would render "45,7" under ru-RU and silently break the width.
    private string CoverPercentText => (100.0 - MeterZoneStyle.Percent(_level.TruePeakDb)).ToString(CultureInfo.InvariantCulture);

    private bool IsPlayingThis => PlaybackService.PlayingChannel == Config.Name;

    private string SourcePrefix => ChannelDisplayFormatter.FormatSourceParts(Config).Prefix;
    private string SourceUrl => ChannelDisplayFormatter.FormatSourceParts(Config).Url;
    private string OutputFormatQuality => ChannelDisplayFormatter.FormatOutputParts(Config, Loc).FormatQuality;
    private string OutputPath => ChannelDisplayFormatter.FormatOutputParts(Config, Loc).Path;
    private string OutputDuration => ChannelDisplayFormatter.FormatOutputParts(Config, Loc).Duration;

    private static string MaskText(string text) => new string('*', Math.Clamp(text.Length, 6, 40));

    protected override void OnInitialized()
    {
        AppSettings.Changed += OnSettingsChanged;
        PlaybackService.Changed += OnSettingsChanged;
        Loc.Changed += OnSettingsChanged;
        UiState.Changed += OnSettingsChanged;
        if (!IsEligibleType) return;

        _status = EngineManager.GetStatus(Config.Name) ?? new EngineStatus();
        _metadataText = EngineManager.GetMetadataText(Config.Name);
        EngineManager.LevelUpdated += OnLevelUpdated;
        EngineManager.StatusUpdated += OnStatusUpdated;
        EngineManager.MetadataUpdated += OnMetadataUpdated;
    }

    private void OnSettingsChanged()
    {
        if (_disposed) return;
        InvokeAsync(StateHasChanged);
    }

    private void TogglePlayback()
    {
        try
        {
            if (IsPlayingThis)
                PlaybackService.Stop();
            else
                PlaybackService.Play(Config.Name);
        }
        catch (Exception ex)
        {
            UiState.SetStatusMessage(Loc.T("channelCard.playbackError", Config.Name, ex.Message));
        }
    }

    private volatile bool _renderPending;

    private void OnLevelUpdated(string channelName, LevelReading reading)
    {
        // ShowTpIndicators off means the card-level indicator module does no work at all, not just
        // "hide the meter" — skip before touching _level or scheduling a render.
        if (_disposed || channelName != Config.Name || !AppSettings.Current.ShowTpIndicators) return;
        _level = reading;
        RequestRender();
    }

    private void OnStatusUpdated(string channelName, EngineStatus status)
    {
        if (_disposed || channelName != Config.Name) return;
        _status = status;
        if (!status.IsRecording)
        {
            _level = new LevelReading();
            _metadataText = null;
        }
        RequestRender();
    }

    private void OnMetadataUpdated(string channelName, string text)
    {
        if (_disposed || channelName != Config.Name) return;
        _metadataText = text;
        RequestRender();
    }

    /// <summary>Coalesces bursts of level/status events into at most one outstanding
    /// <see cref="StateHasChanged"/> dispatch — under transient dispatcher backlog (e.g. thread-pool
    /// contention with many channels running at once), queuing a fresh render per event would pile
    /// up stale re-renders and make the indicator look frozen until the whole backlog drains instead
    /// of catching up to the latest reading on the very next tick.</summary>
    private void RequestRender()
    {
        if (_renderPending) return;
        _renderPending = true;
        var queuedAt = RenderDispatchDiagnostics.StartTimestamp();
        InvokeAsync(() =>
        {
            _renderPending = false;
            RenderDispatchDiagnostics.WarnIfQueueLagged(Log, Config.Name, "ChannelCard.StateHasChanged", queuedAt);
            StateHasChanged();
        });
    }

    private void ToggleRecording()
    {
        if (!IsEligibleType) return;
        if (_status.IsFileRecording)
        {
            EngineManager.Stop(Config.Name);
        }
        else if (_status.IsRecording)
        {
            // Engine is already running, but only because AudioPlaybackService auto-started it for
            // listen-in (suppressRecording: true) — AudioEngineManager.Start() no-ops on an already-
            // running channel, so a plain Start() here would silently do nothing. Restart it properly
            // with recording enabled instead. This briefly interrupts any in-progress listen-in for
            // this channel — an accepted rough edge for the rare case of clicking "Start recording"
            // at the same moment someone's previewing a stopped channel's audio.
            EngineManager.Stop(Config.Name);
            EngineManager.Start(Config.Name);
        }
        else
        {
            EngineManager.Start(Config.Name);
        }
    }

    private void Edit() => UiState.OpenEditChannel(Config);

    private void Clone() => UiState.OpenCloneChannel(Config);

    private void Delete() => UiState.OpenDeleteChannel(Config);

    private void OpenIndicators() => UiState.OpenIndicators(Config.Name);

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        AppSettings.Changed -= OnSettingsChanged;
        PlaybackService.Changed -= OnSettingsChanged;
        Loc.Changed -= OnSettingsChanged;
        UiState.Changed -= OnSettingsChanged;
        if (IsEligibleType)
        {
            EngineManager.LevelUpdated -= OnLevelUpdated;
            EngineManager.StatusUpdated -= OnStatusUpdated;
            EngineManager.MetadataUpdated -= OnMetadataUpdated;
        }
        return ValueTask.CompletedTask;
    }
}
