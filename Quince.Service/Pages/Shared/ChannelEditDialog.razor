@using Microsoft.AspNetCore.Components
@using Quince.Service.Audio
@using Quince.Service.Configuration
@using Quince.Service.Services
@inject ChannelManager ChannelManager
@inject YamlConfigLoader Loader
@inject ChannelUiState UiState
@inject MetadataDetectionService MetadataService

<div class="modal-overlay" @onclick="Close">
    <div class="modal-box modal-box-wide" @onclick:stopPropagation="true">
        <h2>@(_isCreate ? "Новый канал записи" : $"Редактирование канала «{UiState.EditTarget!.Name}»")</h2>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="form-error">@_error</p>
        }

        <div class="form-grid">
            <label title="Отображаемое имя канала (также используется в логах и статусах).">Название</label>
            <input @bind="_draft.Name" @bind:event="oninput" title="Отображаемое имя канала (также используется в логах и статусах)." />

            <label title="Откуда захватывается звук: сетевой поток (Icecast/HLS) или локальная звуковая карта.">Тип источника</label>
            <select @bind="_draft.Source.Type" @bind:after="OnSourceTypeChanged" title="Откуда захватывается звук: сетевой поток (Icecast/HLS) или локальная звуковая карта.">
                <option value="stream">Поток (Icecast/HLS)</option>
                <option value="soundcard">Звуковая карта</option>
            </select>

            @if (_draft.Source.Type == "stream")
            {
                <label title="Адрес аудиопотока (Icecast/HLS плейлист).">URL потока</label>
                <input @bind="_draft.Source.Url" title="Адрес аудиопотока (Icecast/HLS плейлист)." />

                <label title="Формат потока: Icecast, Icecast с MP3, или HLS (плейлист .m3u8).">Тип потока</label>
                <select @bind="_draft.Source.StreamType" title="Формат потока: Icecast, Icecast с MP3, или HLS (плейлист .m3u8).">
                    <option value="icecast">Icecast</option>
                    <option value="icecast_mp3">Icecast (MP3)</option>
                    <option value="hls">HLS</option>
                </select>

                @if (_draft.Source.StreamType == "hls")
                {
                    <label title="Если в HLS-плейлисте несколько аудиодорожек/битрейтов — индекс нужной (0 — первая).">Индекс аудиодорожки HLS</label>
                    <input type="number" @bind="_draft.Source.HlsBitrateIndex" title="Если в HLS-плейлисте несколько аудиодорожек/битрейтов — индекс нужной (0 — первая)." />
                }

                <label title="Разрешить подключение по обычному HTTP, если поток не поддерживает HTTPS.">Доступ по HTTP (не HTTPS)</label>
                <input type="checkbox" @bind="_draft.Source.AllowHttp" title="Разрешить подключение по обычному HTTP, если поток не поддерживает HTTPS." />

                <label title="Не проверять валидность SSL-сертификата сервера (для потоков с самоподписанным/просроченным сертификатом).">Разрешить неверный SSL-сертификат</label>
                <input type="checkbox" @bind="_draft.Source.AllowInvalidSsl" title="Не проверять валидность SSL-сертификата сервера (для потоков с самоподписанным/просроченным сертификатом)." />

                <label title="Режим метаданных потока: пусто — не собирать, «icy» — встроенные ICY-метаданные Icecast, любое другое значение — обнаруженный JSON-эндпоинт метаданных HLS. Можно ввести вручную или подставить кнопкой справа.">URL метаданных / режим</label>
                <div class="input-with-button">
                    <input @bind="_draft.Source.MetadataUrl" placeholder="icy, JSON-эндпоинт, или пусто"
                           title="Режим метаданных потока: пусто — не собирать, «icy» — встроенные ICY-метаданные Icecast, любое другое значение — обнаруженный JSON-эндпоинт метаданных HLS. Можно ввести вручную или подставить кнопкой справа." />
                    <button type="button" class="btn btn-small" @onclick="DetectMetadata" disabled="@_detectingMetadata"
                            title="Определить наличие метаданных (название трека) по текущим настройкам URL/типа потока — результат подставится в поле слева">
                        @(_detectingMetadata ? "Проверка…" : "Определить")
                    </button>
                </div>
                @if (_metadataStatusText is not null)
                {
                    <label></label>
                    <div class="@_metadataStatusClass">@_metadataStatusText</div>
                }
            }
            else
            {
                <label title="Список звуковых устройств записи, обнаруженных в системе сейчас. Выбор подставляет имя и UID устройства ниже.">Устройство записи</label>
                <div class="input-with-button">
                    <select value="@_draft.Source.DeviceUid" @onchange="OnDeviceSelected"
                            title="Список звуковых устройств записи, обнаруженных в системе сейчас. Выбор подставляет имя и UID устройства ниже.">
                        <option value="">— выбрать из списка —</option>
                        @foreach (var d in _devices)
                        {
                            <option value="@d.Driver">@d.Name@(d.IsDefault ? " (по умолчанию)" : "")@(d.IsEnabled ? "" : " (отключено)")</option>
                        }
                        @if (!string.IsNullOrEmpty(_draft.Source.DeviceUid) && !_devices.Any(d => d.Driver == _draft.Source.DeviceUid))
                        {
                            <option value="@_draft.Source.DeviceUid">Текущее (не обнаружено сейчас): @(string.IsNullOrEmpty(_draft.Source.DeviceName) ? _draft.Source.DeviceUid : _draft.Source.DeviceName)</option>
                        }
                    </select>
                    <button type="button" class="btn btn-small" @onclick="RefreshDevices" title="Обновить список устройств (например, после подключения USB-микрофона)">🔄 Обновить</button>
                </div>
                @if (_deviceListError is not null)
                {
                    <label></label>
                    <div class="form-error">@_deviceListError</div>
                }

                <label title="Уникальный идентификатор устройства — используется для сопоставления в первую очередь и устойчив к смене индекса устройства при переподключении USB.">Устройство (UID)</label>
                <input @bind="_draft.Source.DeviceUid" title="Уникальный идентификатор устройства — используется для сопоставления в первую очередь и устойчив к смене индекса устройства при переподключении USB." />

                <label title="Отображаемое имя устройства — подставляется автоматически при выборе из списка выше; используется для поиска, только если UID не задан.">Устройство (имя)</label>
                <input @bind="_draft.Source.DeviceName" title="Отображаемое имя устройства — подставляется автоматически при выборе из списка выше; используется для поиска, только если UID не задан." />
            }

            <label title="Пауза перед повторной попыткой подключения после обрыва, в секундах.">Задержка переподключения, с</label>
            <input type="number" @bind="_draft.Source.ReconnectDelaySeconds" title="Пауза перед повторной попыткой подключения после обрыва, в секундах." />

            <label title="Папка на диске или сетевой путь, куда будут сохраняться аудиофайлы этого канала. Создаётся автоматически, если ещё не существует.">Папка сохранения</label>
            <div class="input-with-button">
                <input @bind="_draft.SavePath" title="Папка на диске или сетевой путь, куда будут сохраняться аудиофайлы этого канала. Создаётся автоматически, если ещё не существует." />
                <button type="button" class="btn btn-small" @onclick="OpenFolderBrowser" disabled="@_browsingFolderNative" title="Выбрать папку на этом сервере">@(_browsingFolderNative ? "Открытие диалога…" : "Обзор…")</button>
            </div>

            <label title="Шаблон имени подпапки по дате записи, например YYYY-MM-DD.">Формат папки по дате</label>
            <input @bind="_draft.DateFolderFormat" title="Шаблон имени подпапки по дате записи, например YYYY-MM-DD." />

            <label title="Шаблон имени файла записи, например hh-mm-ss.">Формат имени файла</label>
            <input @bind="_draft.FileNameFormat" title="Шаблон имени файла записи, например hh-mm-ss." />

            <label title="Через сколько секунд текущий файл записи закрывается и начинается новый.">Длительность файла, с</label>
            <input type="number" @bind="_draft.FileDurationSeconds" title="Через сколько секунд текущий файл записи закрывается и начинается новый." />

            <label title="Через сколько дней старые записи этого канала удаляются автоматически (0 — не удалять).">Хранить записи, дней</label>
            <input type="number" @bind="_draft.RetentionDays" title="Через сколько дней старые записи этого канала удаляются автоматически (0 — не удалять)." />

            <label title="Если выключено — канал только показывает индикаторы уровня, без сохранения на диск.">Вести запись</label>
            <input type="checkbox" @bind="_draft.RecordAudio" title="Если выключено — канал только показывает индикаторы уровня, без сохранения на диск." />

            <label title="Начинать запись автоматически при старте службы (и сразу после создания/появления канала).">Автозапуск при старте службы</label>
            <input type="checkbox" @bind="_draft.AutoStart" title="Начинать запись автоматически при старте службы (и сразу после создания/появления канала)." />

            <label title="«Как во входном потоке» — формат вывода не задаётся отдельно; «Заданный ниже» — открывает настройки формата файла/битрейта/частоты/каналов.">Режим формата вывода</label>
            <select @bind="_draft.OutputFormat.Mode" title="«Как во входном потоке» — формат вывода не задаётся отдельно; «Заданный ниже» — открывает настройки формата файла/битрейта/частоты/каналов.">
                <option value="original">Как во входном потоке</option>
                <option value="custom">Заданный ниже</option>
            </select>

            @if (_draft.OutputFormat.Mode == "original")
            {
                <label></label>
                <div class="form-hint-neutral">Будет сохранено как: @OriginalModeResolvedFormat</div>
            }

            @if (_draft.OutputFormat.Mode == "custom")
            {
                <label title="Формат сохраняемых аудиофайлов.">Формат файла</label>
                <select @bind="_draft.OutputFormat.FileFormat" title="Формат сохраняемых аудиофайлов.">
                    <option value="mp3">MP3</option>
                    <option value="aac">AAC</option>
                    <option value="wav">WAV</option>
                </select>

                @if (_draft.OutputFormat.FileFormat is "mp3" or "aac")
                {
                    <label title="Битрейт кодирования для MP3/AAC, кбит/с.">Битрейт, кбит/с</label>
                    <select @bind="_draft.OutputFormat.BitrateKbps" title="Битрейт кодирования для MP3/AAC, кбит/с.">
                        @foreach (var kbps in BitrateOptions)
                        {
                            <option value="@kbps">@kbps</option>
                        }
                    </select>
                }
                else
                {
                    <label title="Разрядность сэмплов для WAV.">Разрядность, бит</label>
                    <select @bind="_draft.OutputFormat.BitDepth" title="Разрядность сэмплов для WAV.">
                        <option value="16">16</option>
                        <option value="24">24</option>
                    </select>
                }

                <label title="Частота дискретизации выходного файла, Гц.">Частота дискретизации, Гц</label>
                <select @bind="_draft.OutputFormat.SampleRate" title="Частота дискретизации выходного файла, Гц.">
                    @foreach (var rate in SampleRateOptions)
                    {
                        <option value="@rate">@rate</option>
                    }
                </select>

                <label title="Число каналов выходного файла.">Число каналов</label>
                <select @bind="_draft.OutputFormat.Channels" title="Число каналов выходного файла.">
                    <option value="1">Моно</option>
                    <option value="2">Стерео</option>
                </select>
            }

            <label title="Приостанавливать индикацию активности при затяжной тишине во входном сигнале.">Детектор тишины</label>
            <input type="checkbox" @bind="_draft.SilenceDetector.Enabled" title="Приостанавливать индикацию активности при затяжной тишине во входном сигнале." />

            @if (_draft.SilenceDetector.Enabled)
            {
                <label title="Уровень громкости, ниже которого сигнал считается тишиной, dBFS.">Порог, dBFS</label>
                <input type="number" step="0.1" @bind="_draft.SilenceDetector.ThresholdDbfs" title="Уровень громкости, ниже которого сигнал считается тишиной, dBFS." />

                <label title="Через сколько секунд непрерывной тишины сработает детектор.">Срабатывание через, с</label>
                <input type="number" step="0.1" @bind="_draft.SilenceDetector.TriggerSeconds" title="Через сколько секунд непрерывной тишины сработает детектор." />

                <label title="Через сколько секунд звука после тишины детектор снимет флаг тишины.">Возобновление через, с</label>
                <input type="number" step="0.1" @bind="_draft.SilenceDetector.ResumeSeconds" title="Через сколько секунд звука после тишины детектор снимет флаг тишины." />
            }
        </div>

        <div class="form-actions">
            <button class="btn btn-small" @onclick="Close" disabled="@_saving">Отмена</button>
            <button class="btn btn-start" @onclick="Save" disabled="@_saving">@(_saving ? "Проверка папки…" : "Сохранить")</button>
        </div>
    </div>
</div>

@if (_browsingFolder)
{
    <FolderBrowserDialog InitialPath="@_draft.SavePath" OnSelected="OnFolderSelected" OnClose="() => _browsingFolder = false" />
}

@code {
    private static readonly int[] BitrateOptions = { 32, 48, 64, 96, 128, 256, 320 };
    private static readonly int[] SampleRateOptions = { 8000, 11025, 22050, 32000, 44100, 48000, 96000 };

    private ChannelConfig _draft = new();
    private bool _isCreate;
    private string? _error;
    private bool _saving;
    private bool _browsingFolder;
    private bool _browsingFolderNative;

    private List<SoundcardCapture.RecordDeviceInfo> _devices = new();
    private string? _deviceListError;

    private bool _detectingMetadata;
    private string? _metadataStatusText;
    private string _metadataStatusClass = "form-hint-neutral";

    private string OriginalModeResolvedFormat => AudioWriter.ResolveEffectiveFormat(_draft).FileFormat.ToUpperInvariant();

    protected override void OnInitialized()
    {
        var target = UiState.EditTarget;
        _isCreate = target is null;
        _draft = target is null ? new ChannelConfig() : Loader.Clone(target);
        if (_draft.Source.Type == "soundcard")
            RefreshDevices();
        else
            ApplyPopulateMetadataLabel();
    }

    private void OnSourceTypeChanged()
    {
        if (_draft.Source.Type == "soundcard") RefreshDevices();
    }

    private void Close() => UiState.CloseEditChannel();

    private async Task OpenFolderBrowser()
    {
        if (NativeFolderPicker.IsAvailable)
        {
            _browsingFolderNative = true;
            try
            {
                var picked = await NativeFolderPicker.PickAsync(_draft.SavePath);
                if (picked != null) _draft.SavePath = picked;
                return; // shown (and either picked or cancelled) — no need for the in-app fallback
            }
            catch
            {
                // No attached interactive desktop despite UserInteractive==true (e.g. a locked/
                // disconnected session) — fall back to the in-app browser below.
            }
            finally
            {
                _browsingFolderNative = false;
            }
        }
        _browsingFolder = true;
    }

    private void OnFolderSelected(string path) => _draft.SavePath = path;

    private void RefreshDevices()
    {
        try
        {
            _devices = SoundcardCapture.EnumerateDevices();
            _deviceListError = null;
        }
        catch (DllNotFoundException)
        {
            _devices = new();
            _deviceListError = "Библиотека BASS (bass.dll) не найдена или не смогла загрузиться — обычно она лежит рядом с Quince.Service.exe; проверьте, что файл на месте и не заблокирован антивирусом/политикой Windows (см. README). Каналы со звуковой картой недоступны, пока это не исправлено.";
        }
        catch (Exception ex)
        {
            _devices = new();
            _deviceListError = $"Не удалось получить список устройств записи: {ex.Message}";
        }
    }

    private void OnDeviceSelected(ChangeEventArgs e)
    {
        var uid = e.Value?.ToString() ?? "";
        _draft.Source.DeviceUid = uid;
        var match = _devices.FirstOrDefault(d => d.Driver == uid);
        if (!string.IsNullOrEmpty(uid) && !string.IsNullOrEmpty(match.Name))
            _draft.Source.DeviceName = match.Name;
    }

    /// <summary>Sets the status label from an already-stored MetadataUrl (e.g. when opening the
    /// dialog to edit an existing channel) — silent when empty, unlike a fresh detection result,
    /// which explicitly says "not found" (matches the legacy dialog's populate-vs-detect distinction).</summary>
    private void ApplyPopulateMetadataLabel()
    {
        var value = _draft.Source.MetadataUrl;
        if (value == "icy")
        {
            _metadataStatusText = "✓ ICY (Icecast)";
            _metadataStatusClass = "form-hint-ok";
        }
        else if (!string.IsNullOrEmpty(value))
        {
            _metadataStatusText = $"✓ JSON: {value}";
            _metadataStatusClass = "form-hint-ok";
        }
        else
        {
            _metadataStatusText = null;
        }
    }

    private async Task DetectMetadata()
    {
        if (string.IsNullOrWhiteSpace(_draft.Source.Url))
        {
            _metadataStatusText = "⚠ Введите URL потока";
            _metadataStatusClass = "form-hint-warn";
            return;
        }

        _detectingMetadata = true;
        _metadataStatusText = "Проверка…";
        _metadataStatusClass = "form-hint-neutral";
        StateHasChanged();

        MetadataDetectionResult result;
        try
        {
            // Belt-and-braces: DetectAsync already bounds its own network calls with timeouts,
            // but this button must never get stuck showing "Проверка…" forever no matter what
            // goes wrong underneath — an outer deadline guarantees the UI always recovers.
            var detectTask = MetadataService.DetectAsync(_draft.Source);
            var winner = await Task.WhenAny(detectTask, Task.Delay(TimeSpan.FromSeconds(12)));
            result = winner == detectTask
                ? await detectTask
                : new MetadataDetectionResult(false, "", "Превышено время ожидания.");
        }
        catch (Exception ex)
        {
            result = new MetadataDetectionResult(false, "", ex.Message);
        }
        finally
        {
            _detectingMetadata = false;
        }

        if (result.MetadataUrl == "icy")
        {
            _draft.Source.MetadataUrl = result.MetadataUrl;
            _metadataStatusText = "✓ ICY (Icecast)";
            _metadataStatusClass = "form-hint-ok";
        }
        else if (!string.IsNullOrEmpty(result.MetadataUrl))
        {
            _draft.Source.MetadataUrl = result.MetadataUrl;
            _metadataStatusText = $"✓ JSON: {result.MetadataUrl}";
            _metadataStatusClass = "form-hint-ok";
        }
        else
        {
            // Detection failed to confirm anything — leave whatever the user already had in the
            // field untouched instead of clobbering it with an empty result (this used to wipe out
            // a manually-entered, working URL whenever a probe attempt came back empty/timed out).
            _metadataStatusText = string.IsNullOrEmpty(result.Warning)
                ? "✗ Метаданные не найдены"
                : $"✗ Метаданные не найдены: {result.Warning}";
            _metadataStatusClass = "form-error";
        }
    }

    private async Task Save()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_draft.Name))
        {
            _error = "Укажите название канала.";
            return;
        }

        var excludeFilename = _isCreate ? null : UiState.EditTarget!.Filename;
        if (ChannelManager.NameExists(_draft.Name.Trim(), excludeFilename))
        {
            _error = "Канал с таким названием уже существует.";
            return;
        }

        if (_draft.Source.Type == "stream" && string.IsNullOrWhiteSpace(_draft.Source.Url))
        {
            _error = "Укажите URL потока.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_draft.SavePath))
        {
            _error = "Укажите папку сохранения записей.";
            return;
        }

        _saving = true;
        try
        {
            if (!await ValidateSavePathAsync(_draft.SavePath))
                return;
        }
        finally
        {
            _saving = false;
        }

        _draft.Name = _draft.Name.Trim();

        try
        {
            if (_isCreate)
                ChannelManager.Add(_draft);
            else
                ChannelManager.Update(UiState.EditTarget!.Filename, _draft);
        }
        catch (Exception ex)
        {
            // An unhandled exception here would escape the event handler and take down the whole
            // Blazor Server circuit (the browser then shows/forces a full reload) — e.g. if the
            // channel was deleted from another tab/menu action while this dialog was open. Surface
            // it as a normal form error instead.
            _error = $"Не удалось сохранить канал: {ex.Message}";
            return;
        }

        UiState.CloseEditChannel();
    }

    /// <summary>
    /// Creates the folder if it doesn't exist yet (same as always — AudioWriter would create it lazily
    /// anyway) and only surfaces an error when the underlying disk/network share is genuinely
    /// unavailable. Bounded with a timeout so a dead UNC path can't hang the dialog for the ~20-30s
    /// Windows sometimes takes to give up on a network path.
    /// </summary>
    private async Task<bool> ValidateSavePathAsync(string path)
    {
        try
        {
            var task = Task.Run(() => Directory.CreateDirectory(path));
            var completed = await Task.WhenAny(task, Task.Delay(TimeSpan.FromSeconds(5)));
            if (completed != task)
            {
                _error = "Папка сохранения записей недоступна: превышено время ожидания (сетевой путь не отвечает).";
                return false;
            }
            await task; // observe any exception
            return true;
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or NotSupportedException or ArgumentException)
        {
            _error = $"Папка сохранения записей недоступна: {ex.Message}";
            return false;
        }
    }
}
