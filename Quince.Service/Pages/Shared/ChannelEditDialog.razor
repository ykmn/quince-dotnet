@using System.Globalization
@using Microsoft.AspNetCore.Components
@using Quince.Service.Audio
@using Quince.Service.Audio.Livewire
@using Quince.Service.Configuration
@using Quince.Service.Services
@inject ChannelManager ChannelManager
@inject YamlConfigLoader Loader
@inject ChannelUiState UiState
@inject MetadataDetectionService MetadataService
@inject LocalizationService Loc
@inject LivewireDiscoveryService LivewireDiscovery
@inject IJSRuntime JS

<div class="modal-overlay">
    <div class="modal-box modal-box-wide" @onclick:stopPropagation="true">
        <h2>@(_isCreate ? Loc["channelEdit.titleNew"] : Loc.T("channelEdit.titleEdit", UiState.EditTarget!.Name))</h2>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="form-error">@_error</p>
        }

        <div class="form-grid">
            <label title="@Loc["channelEdit.nameTitle"]">@Loc["channelEdit.nameLabel"]</label>
            <input @bind="_draft.Name" @bind:event="oninput" title="@Loc["channelEdit.nameTitle"]" />
        </div>

        <div class="dialog-tabs">
            <button type="button" class="dialog-tab @(_activeTab == Tab.Input ? "dialog-tab-active" : "")" @onclick="() => _activeTab = Tab.Input">@Loc["channelEdit.tabInput"]</button>
            <button type="button" class="dialog-tab @(_activeTab == Tab.Output ? "dialog-tab-active" : "")" @onclick="SwitchToOutputTab">@Loc["channelEdit.tabOutput"]</button>
            <button type="button" class="dialog-tab @(_activeTab == Tab.Silence ? "dialog-tab-active" : "")" @onclick="() => _activeTab = Tab.Silence">@Loc["channelEdit.tabSilence"]</button>
        </div>

        @if (_activeTab == Tab.Input)
        {
            <div class="form-grid">
                <label title="@Loc["channelEdit.sourceTypeTitle"]">@Loc["channelEdit.sourceTypeLabel"]</label>
                <select @bind="_draft.Source.Type" @bind:after="OnSourceTypeChanged" title="@Loc["channelEdit.sourceTypeTitle"]">
                    <option value="stream">@Loc["channelEdit.sourceTypeStream"]</option>
                    <option value="soundcard">@Loc["channelEdit.sourceTypeSoundcard"]</option>
                    @if (IsLivewireConnected || _draft.Source.Type == "livewire")
                    {
                        <option value="livewire">@Loc["channelEdit.sourceTypeLivewire"]</option>
                    }
                </select>

                @if (_draft.Source.Type == "stream")
                {
                    <label title="@Loc["channelEdit.streamUrlTitle"]">@Loc["channelEdit.streamUrlLabel"]</label>
                    <input @bind="_draft.Source.Url" title="@Loc["channelEdit.streamUrlTitle"]" />

                    <label title="@Loc["channelEdit.streamTypeTitle"]">@Loc["channelEdit.streamTypeLabel"]</label>
                    <select @bind="_draft.Source.StreamType" title="@Loc["channelEdit.streamTypeTitle"]">
                        <option value="icecast">@Loc["channelEdit.streamTypeIcecast"]</option>
                        <option value="hls">@Loc["channelEdit.streamTypeHls"]</option>
                    </select>

                    var streamTypeMismatch = ChannelDisplayFormatter.DetectStreamTypeMismatch(_draft.Source);
                    @if (streamTypeMismatch != StreamTypeMismatch.None)
                    {
                        <label></label>
                        <div class="form-hint-warn">
                            @Loc[streamTypeMismatch == StreamTypeMismatch.UrlLooksHlsButTypeIsNot
                                ? "channelEdit.streamTypeMismatchUrlIsHls"
                                : "channelEdit.streamTypeMismatchTypeIsHls"]
                        </div>
                    }

                    @if (_draft.Source.StreamType == "hls")
                    {
                        <label title="@Loc["channelEdit.hlsIndexTitle"]">@Loc["channelEdit.hlsIndexLabel"]</label>
                        <input type="number" @bind="_draft.Source.HlsBitrateIndex" title="@Loc["channelEdit.hlsIndexTitle"]" />
                    }

                    <label title="@Loc["channelEdit.allowHttpTitle"]">@Loc["channelEdit.allowHttpLabel"]</label>
                    <input type="checkbox" @bind="_draft.Source.AllowHttp" title="@Loc["channelEdit.allowHttpTitle"]" />

                    <label title="@Loc["channelEdit.allowInvalidSslTitle"]">@Loc["channelEdit.allowInvalidSslLabel"]</label>
                    <input type="checkbox" @bind="_draft.Source.AllowInvalidSsl" title="@Loc["channelEdit.allowInvalidSslTitle"]" />

                    <label title="@Loc["channelEdit.metadataUrlTitle"]">@Loc["channelEdit.metadataUrlLabel"]</label>
                    <div class="input-with-button">
                        <input @bind="_draft.Source.MetadataUrl" placeholder="@Loc["channelEdit.metadataUrlPlaceholder"]"
                               title="@Loc["channelEdit.metadataUrlTitle"]" />
                        <button type="button" class="btn btn-small" @onclick="DetectMetadata" disabled="@_detectingMetadata"
                                title="@Loc["channelEdit.detectButtonTitle"]">
                            @(_detectingMetadata ? Loc["channelEdit.checking"] : Loc["channelEdit.detect"])
                        </button>
                    </div>
                    @if (_metadataStatusText is not null)
                    {
                        <label></label>
                        <div class="@_metadataStatusClass">@_metadataStatusText</div>
                    }
                }
                else if (_draft.Source.Type == "soundcard")
                {
                    <label title="@Loc["channelEdit.deviceTitle"]">@Loc["channelEdit.deviceLabel"]</label>
                    <div class="input-with-button">
                        <select value="@_draft.Source.DeviceUid" @onchange="OnDeviceSelected"
                                title="@Loc["channelEdit.deviceTitle"]">
                            <option value="">@Loc["channelEdit.deviceChoose"]</option>
                            @foreach (var d in _devices)
                            {
                                <option value="@d.Id">@d.Name@(d.IsDefault ? Loc["channelEdit.deviceDefaultSuffix"] : "")@(d.IsEnabled ? "" : Loc["channelEdit.deviceDisabledSuffix"])</option>
                            }
                            @if (!string.IsNullOrEmpty(_draft.Source.DeviceUid) && !_devices.Any(d => d.Id == _draft.Source.DeviceUid))
                            {
                                <option value="@_draft.Source.DeviceUid">@Loc.T("channelEdit.deviceCurrentUnknown", string.IsNullOrEmpty(_draft.Source.DeviceName) ? _draft.Source.DeviceUid : _draft.Source.DeviceName)</option>
                            }
                        </select>
                        <button type="button" class="btn btn-small" @onclick="RefreshDevices" title="@Loc["channelEdit.refreshDevicesTitle"]">@Loc["common.refresh"]</button>
                    </div>
                    @if (_deviceListError is not null)
                    {
                        <label></label>
                        <div class="form-error">@_deviceListError</div>
                    }

                    <label title="@Loc["channelEdit.deviceUidTitle"]">@Loc["channelEdit.deviceUidLabel"]</label>
                    <input @bind="_draft.Source.DeviceUid" title="@Loc["channelEdit.deviceUidTitle"]" />

                    <label title="@Loc["channelEdit.deviceNameTitle"]">@Loc["channelEdit.deviceNameLabel"]</label>
                    <input @bind="_draft.Source.DeviceName" title="@Loc["channelEdit.deviceNameTitle"]" />
                }
                else if (_draft.Source.Type == "livewire")
                {
                    <label></label>
                    <div class="livewire-filter-row">
                        <input @bind="_livewireFilter" @bind:event="oninput" placeholder="@Loc["channelEdit.livewireFilterPlaceholder"]" />
                        <button type="button" class="btn btn-small" @onclick="OnRefreshLivewireClicked" title="@Loc["channelEdit.livewireRefreshTitle"]">@Loc["common.refresh"]</button>
                    </div>

                    <label></label>
                    <div class="livewire-channel-table-wrap">
                        @if (FilteredLivewireChannels.Count == 0)
                        {
                            <div class="livewire-channel-empty">@Loc.T("channelEdit.livewireNoChannelsFoundListening", LivewireDiscoveryService.AdvertisementPort)</div>
                        }
                        else
                        {
                            <table class="livewire-channel-table" id="livewire-channel-table">
                                <thead>
                                    <tr>
                                        <th>№<span class="col-resizer"></span></th>
                                        <th>@Loc["channelEdit.livewireColumnName"]<span class="col-resizer"></span></th>
                                        <th>@Loc["channelEdit.livewireColumnDeviceName"]<span class="col-resizer"></span></th>
                                        <th>@Loc["channelEdit.livewireColumnDeviceIp"]<span class="col-resizer"></span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in FilteredLivewireChannels)
                                    {
                                        <tr class="livewire-channel-row @(c.Number == _draft.Source.LivewireChannelNumber ? "livewire-channel-row-selected" : "")"
                                            @onclick="() => SelectLivewireChannel(c)">
                                            <td>@c.Number</td>
                                            <td>@c.Name</td>
                                            <td>@c.DeviceName</td>
                                            <td>@(c.DeviceIp?.ToString() ?? "")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                    <label></label>
                    <div class="form-hint-neutral">@Loc.T("channelEdit.livewireFoundCount", FilteredLivewireChannels.Count)</div>

                    <label></label>
                    <div class="@DiscoveryStatusClass">@DiscoveryStatusText</div>

                    <label title="@Loc["channelEdit.livewireChannelNumberTitle"]">@Loc["channelEdit.livewireChannelNumberLabel"]</label>
                    <input type="number" @bind="_draft.Source.LivewireChannelNumber" title="@Loc["channelEdit.livewireChannelNumberTitle"]" />

                    <label title="@Loc["channelEdit.livewireChannelNameTitle"]">@Loc["channelEdit.livewireChannelNameLabel"]</label>
                    <input @bind="_draft.Source.LivewireChannelName" title="@Loc["channelEdit.livewireChannelNameTitle"]" />
                }
            </div>
        }

        @if (_activeTab == Tab.Output)
        {
            <div class="form-grid">
                <label title="@Loc["channelEdit.savePathTitle"]">@Loc["channelEdit.savePathLabel"]</label>
                <div class="input-with-button">
                    <input @bind="_draft.SavePath" title="@Loc["channelEdit.savePathTitle"]" />
                    <button type="button" class="btn btn-small" @onclick="OpenFolderBrowser" title="@Loc["channelEdit.browseTitle"]">@Loc["channelEdit.browse"]</button>
                </div>

                <label title="@Loc["channelEdit.dateFolderTitle"]">@Loc["channelEdit.dateFolderLabel"]</label>
                <input @bind="_draft.DateFolderFormat" title="@Loc["channelEdit.dateFolderTitle"]" />

                <label title="@Loc["channelEdit.fileNameFormatTitle"]">@Loc["channelEdit.fileNameFormatLabel"]</label>
                <input @bind="_draft.FileNameFormat" title="@Loc["channelEdit.fileNameFormatTitle"]" />

                <label title="@Loc["channelEdit.fileDurationTitle"]">@Loc["channelEdit.fileDurationLabel"]</label>
                <input type="number" @bind="_draft.FileDurationMinutes" title="@Loc["channelEdit.fileDurationTitle"]" />

                <label title="@Loc["channelEdit.retentionTitle"]">@Loc["channelEdit.retentionLabel"]</label>
                <input type="number" @bind="_draft.RetentionDays" title="@Loc["channelEdit.retentionTitle"]" />

                <label title="@Loc["channelEdit.recordAudioTitle"]">@Loc["channelEdit.recordAudioLabel"]</label>
                <input type="checkbox" @bind="_draft.RecordAudio" title="@Loc["channelEdit.recordAudioTitle"]" />

                <label title="@Loc["channelEdit.autoStartTitle"]">@Loc["channelEdit.autoStartLabel"]</label>
                <input type="checkbox" @bind="_draft.AutoStart" title="@Loc["channelEdit.autoStartTitle"]" />

                <label title="@Loc["channelEdit.outputModeTitle"]">@Loc["channelEdit.outputModeLabel"]</label>
                <select @bind="_draft.OutputFormat.Mode" title="@Loc["channelEdit.outputModeTitle"]">
                    <option value="original">@Loc["channelEdit.outputModeOriginal"]</option>
                    <option value="custom">@Loc["channelEdit.outputModeCustom"]</option>
                </select>

                @if (_draft.OutputFormat.Mode == "original")
                {
                    <label></label>
                    <div class="form-hint-neutral">@Loc.T("channelEdit.willBeSavedAs", OriginalModeResolvedFormat)</div>
                }

                @if (_draft.OutputFormat.Mode == "custom")
                {
                    <label title="@Loc["channelEdit.fileFormatTitle"]">@Loc["channelEdit.fileFormatLabel"]</label>
                    <select @bind="_draft.OutputFormat.FileFormat" title="@Loc["channelEdit.fileFormatTitle"]">
                        <option value="mp3">MP3</option>
                        <option value="aac">AAC</option>
                        <option value="wav">WAV</option>
                    </select>

                    @if (_draft.OutputFormat.FileFormat is "mp3" or "aac")
                    {
                        <label title="@Loc["channelEdit.bitrateTitle"]">@Loc["channelEdit.bitrateLabel"]</label>
                        <select @bind="_draft.OutputFormat.BitrateKbps" title="@Loc["channelEdit.bitrateTitle"]">
                            @foreach (var kbps in BitrateOptions)
                            {
                                <option value="@kbps">@kbps</option>
                            }
                        </select>
                    }
                    else
                    {
                        <label title="@Loc["channelEdit.bitDepthTitle"]">@Loc["channelEdit.bitDepthLabel"]</label>
                        <select @bind="_draft.OutputFormat.BitDepth" title="@Loc["channelEdit.bitDepthTitle"]">
                            <option value="16">16</option>
                            <option value="24">24</option>
                        </select>
                    }

                    <label title="@Loc["channelEdit.sampleRateTitle"]">@Loc["channelEdit.sampleRateLabel"]</label>
                    <select @bind="_draft.OutputFormat.SampleRate" title="@Loc["channelEdit.sampleRateTitle"]">
                        @foreach (var rate in SampleRateOptions)
                        {
                            <option value="@rate">@rate</option>
                        }
                    </select>

                    <label title="@Loc["channelEdit.channelsTitle"]">@Loc["channelEdit.channelsLabel"]</label>
                    <select @bind="_draft.OutputFormat.Channels" title="@Loc["channelEdit.channelsTitle"]">
                        <option value="1">@Loc["channelEdit.channelsMono"]</option>
                        <option value="2">@Loc["channelEdit.channelsStereo"]</option>
                    </select>
                }
            </div>

            <div class="disk-usage-section">
                <div class="disk-usage-header">
                    <span>@Loc["channelEdit.diskUsageTitle"]</span>
                    <button type="button" class="btn btn-small" @onclick="RefreshDiskUsageAsync" disabled="@_scanningDiskUsage"
                            title="@Loc["channelEdit.diskUsageRefreshTitle"]">
                        @(_scanningDiskUsage ? Loc["channelEdit.diskUsageScanning"] : Loc["common.refresh"])
                    </button>
                </div>
                <div class="disk-usage-track">
                    <div class="disk-usage-fill @DiskUsageZoneClass" style="width: @(DiskUsageFillPercentText)%;"></div>
                </div>
                <div class="form-hint-neutral">@DiskUsageSummaryText</div>
                @if (_diskUsageError is not null)
                {
                    <div class="form-error">@_diskUsageError</div>
                }
            </div>
        }

        @if (_activeTab == Tab.Silence)
        {
            <div class="form-grid">
                <label title="@Loc["channelEdit.silenceDetectorTitle"]">@Loc["channelEdit.silenceDetectorLabel"]</label>
                <input type="checkbox" @bind="_draft.SilenceDetector.Enabled" title="@Loc["channelEdit.silenceDetectorTitle"]" />

                @if (_draft.SilenceDetector.Enabled)
                {
                    <label title="@Loc["channelEdit.thresholdTitle"]">@Loc["channelEdit.thresholdLabel"]</label>
                    <input type="number" step="0.1" @bind="_draft.SilenceDetector.ThresholdDbfs" title="@Loc["channelEdit.thresholdTitle"]" />

                    <label title="@Loc["channelEdit.triggerTitle"]">@Loc["channelEdit.triggerLabel"]</label>
                    <input type="number" step="0.1" @bind="_draft.SilenceDetector.TriggerSeconds" title="@Loc["channelEdit.triggerTitle"]" />

                    <label title="@Loc["channelEdit.resumeTitle"]">@Loc["channelEdit.resumeLabel"]</label>
                    <input type="number" step="0.1" @bind="_draft.SilenceDetector.ResumeSeconds" title="@Loc["channelEdit.resumeTitle"]" />

                    <label title="@Loc["channelEdit.dontStopRecordingTitle"]">@Loc["channelEdit.dontStopRecordingLabel"]</label>
                    <input type="checkbox" @bind="_draft.SilenceDetector.DontStopRecording" title="@Loc["channelEdit.dontStopRecordingTitle"]" />
                }
            </div>
        }

        <div class="form-actions">
            <button class="btn btn-small" @onclick="Close" disabled="@_saving">@Loc["common.cancel"]</button>
            <button class="btn btn-start" @onclick="Save" disabled="@_saving">@(_saving ? Loc["channelEdit.saving"] : Loc["common.save"])</button>
        </div>
    </div>
</div>

@if (_browsingFolder)
{
    <FolderBrowserDialog InitialPath="@_draft.SavePath" OnSelected="OnFolderSelected" OnClose="() => _browsingFolder = false" />
}

@code {
    private static readonly int[] BitrateOptions = { 32, 48, 64, 96, 128, 256, 320 };
    private static readonly int[] SampleRateOptions = { 8000, 11025, 22050, 32000, 44100, 48000, 96000 };

    private enum Tab { Input, Output, Silence }

    private ChannelConfig _draft = new();
    private bool _isCreate;
    private string? _error;
    private bool _saving;
    private bool _browsingFolder;
    private Tab _activeTab = Tab.Input;

    private List<SoundcardCapture.RecordDeviceInfo> _devices = new();
    private string? _deviceListError;

    private List<DiscoveredLivewireChannel> _livewireChannels = new();
    private string _livewireFilter = "";
    private LivewireDiscoveryStatus? _discoveryStatus;

    private bool _detectingMetadata;
    private string? _metadataStatusText;
    private string _metadataStatusClass = "form-hint-neutral";

    // Disk-usage indicator ("Выход" tab): the folder scan is I/O (recursive file enumeration, maybe
    // over a slow network share) so it only runs once per dialog open (lazily, the first time the
    // Output tab is shown — see SwitchToOutputTab) or on the explicit refresh button, never on every
    // keystroke. The bitrate/retention projection itself is pure math (DiskUsageEstimator) and stays
    // live off `_draft` with no I/O involved.
    private bool _diskUsageLoaded;
    private bool _scanningDiskUsage;
    private long? _currentUsageBytes;
    private string? _diskUsageError;

    private string OriginalModeResolvedFormat => AudioWriter.ResolveEffectiveFormat(_draft).FileFormat.ToUpperInvariant();

    private List<DiscoveredLivewireChannel> FilteredLivewireChannels => string.IsNullOrWhiteSpace(_livewireFilter)
        ? _livewireChannels
        : _livewireChannels.Where(c =>
                c.Name.Contains(_livewireFilter, StringComparison.OrdinalIgnoreCase) ||
                c.Number.ToString().Contains(_livewireFilter, StringComparison.OrdinalIgnoreCase))
            .ToList();

    /// <summary>Human-readable line for what <see cref="LivewireDiscoveryService"/> is doing right now
    /// (listening/disabled/error, and whether any traffic has actually arrived) — a snapshot taken
    /// alongside <see cref="RefreshLivewireChannels"/>, not a live push, same as the "Найдено N каналов"
    /// line above it. Formatting is shared with <c>AppSettingsDialog</c>'s Подключить/Отключить status
    /// line via <see cref="LivewireStatusFormatter"/>, so the two never describe the same state differently.</summary>
    private string DiscoveryStatusText => LivewireStatusFormatter.Text(_discoveryStatus, Loc);

    private string DiscoveryStatusClass => LivewireStatusFormatter.CssClass(_discoveryStatus);

    /// <summary>Whether the "livewire" option should be offered in the source-type <c>&lt;select&gt;</c>
    /// below: while the discovery socket isn't connected (App Settings' Подключить/Отключить toggle),
    /// a new Livewire channel can't be created — though a channel already set to "livewire" stays
    /// selectable/visible while it's open for editing, regardless of connection state (see the
    /// surrounding <c>@if</c> on the option itself).</summary>
    private bool IsLivewireConnected => LivewireDiscovery.GetStatus().State == LivewireDiscoveryState.Listening;

    protected override void OnInitialized()
    {
        var target = UiState.EditTarget;
        _isCreate = target is null;
        _draft = target is null ? new ChannelConfig() : Loader.Clone(target);
        // "icecast_mp3" was a distinct dropdown option that never actually behaved differently from
        // "icecast" anywhere at runtime (docs/HISTORY.md #62) — normalize silently so the merged
        // two-option <select> shows a real selection instead of nothing for older saved channels.
        if (_draft.Source.StreamType == "icecast_mp3") _draft.Source.StreamType = "icecast";
        if (_draft.Source.Type == "soundcard")
            RefreshDevices();
        else if (_draft.Source.Type == "livewire")
            RefreshLivewireChannels();
        else
            ApplyPopulateMetadataLabel();
    }

    private void OnSourceTypeChanged()
    {
        if (_draft.Source.Type == "soundcard") RefreshDevices();
        else if (_draft.Source.Type == "livewire") RefreshLivewireChannels();
    }

    private void SwitchToOutputTab()
    {
        _activeTab = Tab.Output;
        if (!_diskUsageLoaded) _ = RefreshDiskUsageAsync();
    }

    private long? EstimatedTotalBytes => DiskUsageEstimator.EstimateTotalBytes(_draft);

    private double DiskUsageFillPercent
    {
        get
        {
            if (_currentUsageBytes is not long used || EstimatedTotalBytes is not long total || total <= 0) return 0;
            return Math.Clamp(used / (double)total * 100.0, 0, 100);
        }
    }

    // CSS numbers must use '.' as the decimal separator regardless of server locale, same pitfall as
    // ChannelCard's CoverPercentText (docs/HISTORY.md — ru-RU renders "45,7", invalid CSS). Rounded to
    // 2 decimal places for the summary text's "X% от прогноза" — the bar's own width tolerates the
    // same precision fine.
    private string DiskUsageFillPercentText => DiskUsageFillPercent.ToString("F2", CultureInfo.InvariantCulture);

    private string DiskUsageZoneClass => DiskUsageFillPercent switch
    {
        >= 90 => "disk-usage-fill-danger",
        >= 70 => "disk-usage-fill-warn",
        _ => "disk-usage-fill-ok",
    };

    private static string FormatGb(long bytes) => (bytes / (1024.0 * 1024 * 1024)).ToString("F2", CultureInfo.InvariantCulture);

    private string DiskUsageSummaryText
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_draft.SavePath)) return Loc["channelEdit.diskUsageNoPath"];
            if (_currentUsageBytes is not long used) return _scanningDiskUsage ? Loc["channelEdit.diskUsageScanning"] : Loc["channelEdit.diskUsageNoPath"];

            var usedText = Loc.T("channelEdit.diskUsageGb", FormatGb(used));
            if (EstimatedTotalBytes is not long total)
                return Loc.T("channelEdit.diskUsageSummaryUnlimited", usedText);

            var totalText = Loc.T("channelEdit.diskUsageGb", FormatGb(total));
            return Loc.T("channelEdit.diskUsageSummaryLimited", totalText, _draft.RetentionDays, usedText, DiskUsageFillPercentText);
        }
    }

    /// <summary>Delegates to <see cref="DiskUsageEstimator.ScanFolderSizeAsync"/> (20s budget) — see
    /// that method's doc for why the timeout is this generous and why a first scan on a large local
    /// folder can still legitimately hit it (cold NTFS metadata cache, not a broken path).</summary>
    private async Task RefreshDiskUsageAsync()
    {
        if (string.IsNullOrWhiteSpace(_draft.SavePath))
        {
            _diskUsageLoaded = true;
            return;
        }

        _scanningDiskUsage = true;
        _diskUsageError = null;
        StateHasChanged();

        var result = await DiskUsageEstimator.ScanFolderSizeAsync(_draft.SavePath, TimeSpan.FromSeconds(20));
        if (result.TimedOut)
        {
            _diskUsageError = Loc["channelEdit.diskUsageScanTimeout"];
        }
        else if (result.Error is not null)
        {
            _diskUsageError = Loc.T("channelEdit.diskUsageScanError", result.Error);
        }
        else
        {
            _currentUsageBytes = result.Bytes;
        }

        _scanningDiskUsage = false;
        _diskUsageLoaded = true;
        StateHasChanged();
    }

    /// <summary>Re-attaches the column-resize drag handles every render — cheap no-op once the table's
    /// already wired up (see columnResize.js's own dataset guard), but needed at least once after the
    /// Livewire tab's table first appears in the DOM (it doesn't exist yet on the dialog's very first
    /// render if the channel being edited isn't a Livewire source, or the table is in its empty state).</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_draft.Source.Type == "livewire" && FilteredLivewireChannels.Count > 0)
            await JS.InvokeVoidAsync("quinceColumnResize.init", "livewire-channel-table");
    }

    private void Close() => UiState.CloseEditChannel();

    /// <summary>
    /// Always browses the filesystem of the machine running Quince.Service (via FolderBrowserService),
    /// never a native OS dialog: a native FolderBrowserDialog runs in-process on the SERVER, which is
    /// only usable when the person clicking "Обзор…" is physically/remotely (RDP) at that exact
    /// machine's interactive desktop — for any other client (a different PC's browser, a phone, a
    /// proper Windows Service with no desktop at all) it would silently pop up somewhere nobody can
    /// see it. The in-app browser works identically and correctly in every deployment scenario.
    /// </summary>
    private void OpenFolderBrowser() => _browsingFolder = true;

    private void OnFolderSelected(string path) => _draft.SavePath = path;

    private void RefreshDevices()
    {
        try
        {
            _devices = SoundcardCapture.EnumerateDevices();
            _deviceListError = null;
        }
        catch (System.Runtime.InteropServices.COMException ex)
        {
            _devices = new();
            _deviceListError = Loc.T("channelEdit.errorDeviceListWindows", ex.Message);
        }
        catch (Exception ex)
        {
            _devices = new();
            _deviceListError = Loc.T("channelEdit.errorDeviceListGeneric", ex.Message);
        }
    }

    private void OnDeviceSelected(ChangeEventArgs e)
    {
        var uid = e.Value?.ToString() ?? "";
        _draft.Source.DeviceUid = uid;
        var match = _devices.FirstOrDefault(d => d.Id == uid);
        if (!string.IsNullOrEmpty(uid) && !string.IsNullOrEmpty(match.Name))
            _draft.Source.DeviceName = match.Name;
    }

    /// <summary>Pulls the current snapshot from the app-wide <see cref="LivewireDiscoveryService"/> —
    /// empty until at least one Advertisement/LWRP sighting has come in (or a cached
    /// <c>livewire.yaml</c> was loaded at startup), in which case the table shows the empty-state hint
    /// and manual entry remains the working path.</summary>
    private void RefreshLivewireChannels()
    {
        _livewireChannels = LivewireDiscovery.GetSnapshot().ToList();
        _discoveryStatus = LivewireDiscovery.GetStatus();
    }

    /// <summary>The "Обновить" button does both: refreshes what's shown right now, and persists that
    /// snapshot to <c>config/livewire.yaml</c> so it's there immediately on the next app start instead
    /// of an empty list until fresh traffic arrives. Deliberately not tied to every dialog open/source-
    /// type-switch (<see cref="RefreshLivewireChannels"/> alone handles those) — a disk write should be
    /// a deliberate action, not a side effect of just looking at the form.</summary>
    private void OnRefreshLivewireClicked()
    {
        RefreshLivewireChannels();
        LivewireDiscovery.SaveSnapshotToCache();
    }

    private void SelectLivewireChannel(DiscoveredLivewireChannel channel)
    {
        _draft.Source.LivewireChannelNumber = channel.Number;
        _draft.Source.LivewireChannelName = channel.Name;
    }

    /// <summary>Sets the status label from an already-stored MetadataUrl (e.g. when opening the
    /// dialog to edit an existing channel) — silent when empty, unlike a fresh detection result,
    /// which explicitly says "not found" (matches the legacy dialog's populate-vs-detect distinction).</summary>
    private void ApplyPopulateMetadataLabel()
    {
        var value = _draft.Source.MetadataUrl;
        if (value == "icy")
        {
            _metadataStatusText = Loc["channelEdit.metadataOkIcy"];
            _metadataStatusClass = "form-hint-ok";
        }
        else if (!string.IsNullOrEmpty(value))
        {
            _metadataStatusText = Loc.T("channelEdit.metadataOkJson", value);
            _metadataStatusClass = "form-hint-ok";
        }
        else
        {
            _metadataStatusText = null;
        }
    }

    private async Task DetectMetadata()
    {
        if (string.IsNullOrWhiteSpace(_draft.Source.Url))
        {
            _metadataStatusText = Loc["channelEdit.metadataEnterUrl"];
            _metadataStatusClass = "form-hint-warn";
            return;
        }

        _detectingMetadata = true;
        _metadataStatusText = Loc["channelEdit.checking"];
        _metadataStatusClass = "form-hint-neutral";
        StateHasChanged();

        MetadataDetectionResult result;
        try
        {
            // Belt-and-braces: DetectAsync already bounds its own network calls with timeouts,
            // but this button must never get stuck showing "Проверка…" forever no matter what
            // goes wrong underneath — an outer deadline guarantees the UI always recovers.
            var detectTask = MetadataService.DetectAsync(_draft.Source);
            var winner = await Task.WhenAny(detectTask, Task.Delay(TimeSpan.FromSeconds(12)));
            result = winner == detectTask
                ? await detectTask
                : new MetadataDetectionResult(false, "", Loc["channelEdit.metadataTimeout"]);
        }
        catch (Exception ex)
        {
            result = new MetadataDetectionResult(false, "", ex.Message);
        }
        finally
        {
            _detectingMetadata = false;
        }

        if (result.MetadataUrl == "icy")
        {
            _draft.Source.MetadataUrl = result.MetadataUrl;
            _metadataStatusText = Loc["channelEdit.metadataOkIcy"];
            _metadataStatusClass = "form-hint-ok";
        }
        else if (!string.IsNullOrEmpty(result.MetadataUrl))
        {
            _draft.Source.MetadataUrl = result.MetadataUrl;
            _metadataStatusText = Loc.T("channelEdit.metadataOkJson", result.MetadataUrl);
            _metadataStatusClass = "form-hint-ok";
        }
        else
        {
            // Detection failed to confirm anything — leave whatever the user already had in the
            // field untouched instead of clobbering it with an empty result (this used to wipe out
            // a manually-entered, working URL whenever a probe attempt came back empty/timed out).
            _metadataStatusText = string.IsNullOrEmpty(result.Warning)
                ? Loc["channelEdit.metadataNotFound"]
                : Loc.T("channelEdit.metadataNotFoundWithReason", result.Warning);
            _metadataStatusClass = "form-error";
        }
    }

    private async Task Save()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_draft.Name))
        {
            _error = Loc["channelEdit.errorNameRequired"];
            return;
        }

        var excludeFilename = _isCreate ? null : UiState.EditTarget!.Filename;
        if (ChannelManager.NameExists(_draft.Name.Trim(), excludeFilename))
        {
            _error = Loc["channelEdit.errorNameExists"];
            return;
        }

        if (_draft.Source.Type == "stream" && string.IsNullOrWhiteSpace(_draft.Source.Url))
        {
            _error = Loc["channelEdit.errorUrlRequired"];
            _activeTab = Tab.Input;
            return;
        }

        if (_draft.Source.Type == "livewire" && !LivewireAddressing.IsValidChannelNumber(_draft.Source.LivewireChannelNumber))
        {
            _error = Loc["channelEdit.errorLivewireChannelRequired"];
            _activeTab = Tab.Input;
            return;
        }

        if (string.IsNullOrWhiteSpace(_draft.SavePath))
        {
            _error = Loc["channelEdit.errorSavePathRequired"];
            _activeTab = Tab.Output;
            return;
        }

        _saving = true;
        try
        {
            if (!await ValidateSavePathAsync(_draft.SavePath))
            {
                _activeTab = Tab.Output;
                return;
            }
        }
        finally
        {
            _saving = false;
        }

        _draft.Name = _draft.Name.Trim();

        try
        {
            if (_isCreate)
                ChannelManager.Add(_draft);
            else
                ChannelManager.Update(UiState.EditTarget!.Filename, _draft);
        }
        catch (Exception ex)
        {
            // An unhandled exception here would escape the event handler and take down the whole
            // Blazor Server circuit (the browser then shows/forces a full reload) — e.g. if the
            // channel was deleted from another tab/menu action while this dialog was open. Surface
            // it as a normal form error instead.
            _error = Loc.T("channelEdit.errorSaveFailed", ex.Message);
            return;
        }

        UiState.CloseEditChannel();
    }

    /// <summary>
    /// Creates the folder if it doesn't exist yet (same as always — AudioWriter would create it lazily
    /// anyway) and only surfaces an error when the underlying disk/network share is genuinely
    /// unavailable. Bounded with a timeout so a dead UNC path can't hang the dialog for the ~20-30s
    /// Windows sometimes takes to give up on a network path. Matches <see cref="RefreshDiskUsageAsync"/>'s
    /// budget (was 5s here vs 8s there — confirmed live on a real busy save disk that a single
    /// <see cref="Directory.CreateDirectory"/> call can occasionally take longer than 5s even though
    /// the path is genuinely fine, giving a false "недоступна" error that a same-second manual
    /// "Обновить" — going through the more generous 8s budget — didn't hit).
    /// </summary>
    private async Task<bool> ValidateSavePathAsync(string path)
    {
        try
        {
            var task = Task.Run(() => Directory.CreateDirectory(path));
            var completed = await Task.WhenAny(task, Task.Delay(TimeSpan.FromSeconds(10)));
            if (completed != task)
            {
                _error = Loc["channelEdit.errorSavePathTimeout"];
                return false;
            }
            await task; // observe any exception
            return true;
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or NotSupportedException or ArgumentException)
        {
            _error = Loc.T("channelEdit.errorSavePathUnavailable", ex.Message);
            return false;
        }
    }
}
