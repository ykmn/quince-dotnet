@inherits LayoutComponentBase
@using Quince.Service.Services
@inject ChannelManager ChannelManager
@inject AudioEngineManager EngineManager
@inject ChannelUiState UiState
@inject LocalizationService Loc
@inject AudioPlaybackService PlaybackService
@inject Microsoft.Extensions.Hosting.IHostApplicationLifetime Lifetime
@inject IJSRuntime JS
@implements IDisposable

<div class="topbar">
    <div class="app-brand">
        <a class="app-brand-link" href="/" title="@Loc["topbar.homeTitle"]">
            <img src="icon.svg" width="64" height="64" alt="" />
            <span class="app-name">Айва</span>
        </a>
    </div>
    <div class="hamburger-wrap">
        <button class="btn-hamburger" title="@Loc["topbar.menuTitle"]" @onclick="ToggleMenu" @onclick:stopPropagation="true">☰</button>
        @if (_menuOpen)
        {
            <div class="menu-overlay" @onclick="CloseMenu"></div>
            <div class="hamburger-menu" @onclick:stopPropagation="true">
                <button class="menu-item" title="@Loc["menu.newChannelTitle"]" @onclick="NewChannel">@Loc["menu.newChannel"]</button>
                <div class="menu-sep"></div>
                <button class="menu-item" title="@Loc["menu.startAllTitle"]" @onclick="StartAll">@Loc["menu.startAll"]</button>
                <button class="menu-item" title="@Loc["menu.stopAllTitle"]" @onclick="StopAll">@Loc["menu.stopAll"]</button>
                <div class="menu-sep"></div>
                <button class="menu-item" title="@Loc["menu.settingsTitle"]" @onclick="OpenSettings">@Loc["menu.settings"]</button>
                <div class="menu-sep"></div>
                <button class="menu-item" title="@Loc["menu.refreshConfigTitle"]" @onclick="RefreshConfig">@Loc["menu.refreshConfig"]</button>
                <button class="menu-item" title="@Loc["menu.restartTitle"]" @onclick="AskRestart">@Loc["menu.restart"]</button>
                <div class="menu-sep"></div>
                <button class="menu-item" title="@Loc["menu.readmeTitle"]" @onclick="OpenReadme">@Loc["menu.readme"]</button>
                <div class="menu-sep"></div>
                <div class="menu-lang-row" title="@Loc["menu.languageTitle"]">
                    <span class="menu-lang-icon">🌐</span>
                    <button type="button" class="dialog-tab @(Loc.Language == "ru" ? "dialog-tab-active" : "")" @onclick='() => SetLanguage("ru")'>RU</button>
                    <button type="button" class="dialog-tab @(Loc.Language == "en" ? "dialog-tab-active" : "")" @onclick='() => SetLanguage("en")'>EN</button>
                </div>
                <div class="menu-sep"></div>
                <span class="menu-version" title="@Loc["menu.versionTitle"]">@_version</span>
                <button class="menu-item" title="@Loc["menu.aboutTitle"]" @onclick="ShowAbout">@Loc["menu.about"]</button>
            </div>
        }
    </div>
</div>

<div class="app-body-row">
    <main class="app-main">
        @Body
    </main>
    @if (UiState.IndicatorsOpen && UiState.IndicatorsChannelName is not null)
    {
        <IndicatorsPanel ChannelName="@UiState.IndicatorsChannelName" OnClose="UiState.CloseIndicators" />
    }
</div>

@if (_aboutOpen)
{
    <div class="modal-overlay" @onclick="CloseAbout">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="about-header">
                <img src="icon.svg" width="48" height="48" alt="" />
                <h2>Айва (Quince)</h2>
            </div>
            <p>@Loc["about.subtitle"]</p>
            <p>@Loc.T("about.version", _version)</p>
            <p class="about-copyright">© 2026 Роман Ермаков — <a href="https://github.com/ykmn/quince-dotnet" target="_blank" rel="noopener">github.com/ykmn/quince-dotnet</a></p>
            <button class="btn btn-small" @onclick="CloseAbout">@Loc["common.close"]</button>
        </div>
    </div>
}

@if (_confirmRestart)
{
    <div class="modal-overlay" @onclick="() => _confirmRestart = false">
        <div class="modal-box" @onclick:stopPropagation="true">
            <h2>@Loc["restartConfirm.title"]</h2>
            <p>@Loc["restartConfirm.body"]</p>
            <div class="form-actions">
                <button class="btn btn-small" @onclick="() => _confirmRestart = false">@Loc["common.cancel"]</button>
                <button class="btn btn-stop" @onclick="DoRestart">@Loc["restartConfirm.confirm"]</button>
            </div>
        </div>
    </div>
}

@if (UiState.EditDialogOpen)
{
    <ChannelEditDialog />
}

@if (UiState.DeleteTarget is not null)
{
    <DeleteChannelDialog Config="UiState.DeleteTarget" OnClose="UiState.CloseDeleteChannel" />
}

@if (UiState.CloneTarget is not null)
{
    <CloneChannelDialog Config="UiState.CloneTarget" OnClose="UiState.CloseCloneChannel" />
}

@if (UiState.SettingsOpen)
{
    <AppSettingsDialog OnClose="UiState.CloseSettings" />
}

@if (UiState.ReadmeOpen)
{
    <ReadmeDialog OnClose="UiState.CloseReadme" />
}

<audio id="quince-playback-audio" style="display:none"></audio>

@code {
    private bool _menuOpen;
    private bool _aboutOpen;
    private bool _confirmRestart;
    private readonly string _version = "v" + VersionInfo.Version;

    protected override void OnInitialized()
    {
        UiState.Changed += OnUiStateChanged;
        Loc.Changed += OnUiStateChanged;
        PlaybackService.Changed += OnPlaybackChanged;
    }

    private void OnUiStateChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Drives the hidden &lt;audio&gt; element via JS interop whenever the monitored
    /// channel changes — the actual audio bytes come from <see cref="AudioStreamEndpoint"/>, this
    /// just points the element at (or away from) that URL. Playback always goes to the browser's
    /// current default output device (see playback.js for why device selection isn't available yet).</summary>
    private void OnPlaybackChanged()
    {
        var channel = PlaybackService.PlayingChannel;
        _ = InvokeAsync(async () =>
        {
            if (channel is null)
                await JS.InvokeVoidAsync("quincePlayback.stop");
            else
                await JS.InvokeVoidAsync("quincePlayback.play", $"/api/playback/stream/{Uri.EscapeDataString(channel)}");
        });
    }

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;

    private void SetLanguage(string language)
    {
        try
        {
            Loc.SetLanguage(language);
        }
        catch (Exception ex)
        {
            // Same class of bug as the comment in ChannelEditDialog.Save(): an unhandled exception
            // here would escape the event handler and take down the whole Blazor Server circuit
            // (forcing a full browser reload) instead of just failing this one menu click.
            CloseMenu();
            UiState.SetStatusMessage(Loc.T("status.languageSaveError", ex.Message));
        }
    }

    private void ShowAbout()
    {
        _menuOpen = false;
        _aboutOpen = true;
    }

    private void CloseAbout() => _aboutOpen = false;

    private void NewChannel()
    {
        CloseMenu();
        UiState.OpenCreateChannel();
    }

    private void OpenSettings()
    {
        CloseMenu();
        UiState.OpenSettings();
    }

    private void RefreshConfig()
    {
        CloseMenu();
        var result = ChannelManager.Reload();
        UiState.SetStatusMessage(result.Error is not null
            ? Loc.T("status.configRefreshError", result.Error)
            : Loc.T("status.configRefreshed", result.Added, result.Updated, result.Removed));
    }

    private void AskRestart()
    {
        CloseMenu();
        _confirmRestart = true;
    }

    private void DoRestart()
    {
        _confirmRestart = false;
        UiState.SetStatusMessage(Loc["status.restarting"]);
        Lifetime.StopApplication();
    }

    private void StartAll()
    {
        CloseMenu();
        var (started, eligible) = EngineManager.StartAll();
        UiState.SetStatusMessage(Loc.T("status.startedAll", started, eligible));
    }

    private void StopAll()
    {
        CloseMenu();
        var stopped = EngineManager.StopAll();
        UiState.SetStatusMessage(Loc.T("status.stoppedAll", stopped));
    }

    private void OpenReadme()
    {
        CloseMenu();
        UiState.OpenReadme();
    }

    public void Dispose()
    {
        UiState.Changed -= OnUiStateChanged;
        Loc.Changed -= OnUiStateChanged;
        PlaybackService.Changed -= OnPlaybackChanged;
    }
}
