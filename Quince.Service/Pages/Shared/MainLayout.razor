@inherits LayoutComponentBase
@using System.Globalization
@using Quince.Service.Services
@using Quince.Service.Services.Auth
@inject ChannelManager ChannelManager
@inject AudioEngineManager EngineManager
@inject ChannelUiState UiState
@inject AppSettingsService AppSettings
@inject LocalizationService Loc
@inject AudioPlaybackService PlaybackService
@inject IJSRuntime JS
@implements IDisposable

<div class="topbar">
    <div class="app-brand">
        <a class="app-brand-link" href="/" title="@Loc["topbar.homeTitle"]">
            <img src="icon.svg" width="64" height="64" alt="" />
            <span class="app-name">Айва@(DevelopSuffix)</span>
        </a>
    </div>
    <div class="hamburger-wrap">
        <button class="btn-hamburger" title="@Loc["topbar.menuTitle"]" @onclick="ToggleMenu" @onclick:stopPropagation="true">☰</button>
        @if (_menuOpen)
        {
            <div class="menu-overlay" @onclick="CloseMenu"></div>
            <div class="hamburger-menu" @onclick:stopPropagation="true">
                <button class="menu-item" title="@Loc["menu.themeTitle"]" @onclick="ToggleTheme">
                    @(_theme == "dark" ? "☀️ " + Loc["menu.themeSwitchToLight"] : "🌙 " + Loc["menu.themeSwitchToDark"])
                </button>
                <div class="menu-lang-row" title="@Loc["menu.languageTitle"]">
                    <span class="menu-lang-icon">🌐</span>
                    <span class="menu-lang-label">@Loc["menu.language"]</span>
                    <div class="menu-toggle-pills">
                        <button type="button" class="dialog-tab @(Loc.Language == "ru" ? "dialog-tab-active" : "")" @onclick='() => SetLanguage("ru")'>RU</button>
                        <button type="button" class="dialog-tab @(Loc.Language == "en" ? "dialog-tab-active" : "")" @onclick='() => SetLanguage("en")'>EN</button>
                    </div>
                </div>
                <div class="menu-sep"></div>
                <button class="menu-item" title="@Loc["menu.newChannelTitle"]" @onclick="NewChannel">@Loc["menu.newChannel"]</button>
                <div class="menu-sep"></div>
                <button class="menu-item" title="@Loc["menu.startAllTitle"]" @onclick="StartAll">@Loc["menu.startAll"]</button>
                <button class="menu-item" title="@Loc["menu.stopAllTitle"]" @onclick="StopAll">@Loc["menu.stopAll"]</button>
                <div class="menu-sep"></div>
                <button class="menu-item" title="@Loc["menu.refreshConfigTitle"]" @onclick="RefreshConfig">@Loc["menu.refreshConfig"]</button>
                <div class="menu-sep"></div>
                <button class="menu-item" title="@Loc["menu.tpIndicatorsTitle"]" @onclick="ToggleTpIndicators">
                    @(AppSettings.Current.ShowTpIndicators ? Loc["menu.tpIndicatorsHideAction"] : Loc["menu.tpIndicatorsShowAction"])
                </button>
                <button class="menu-item" title="@Loc["menu.bulkEditTitle"]" @onclick="ToggleBulkSelectMode">
                    @(UiState.BulkSelectMode ? Loc["menu.bulkEditStop"] : Loc["menu.bulkEditStart"])
                </button>
                <div class="menu-sep"></div>
                <button class="menu-item" title="@Loc["menu.settingsTitle"]" @onclick="OpenSettings">@Loc["menu.settings"]</button>
                <div class="menu-sep"></div>
                <button class="menu-item" title="@Loc["menu.readmeTitle"]" @onclick="OpenReadme">@Loc["menu.readme"]</button>

                @if (CurrentUser is { AuthRequired: true })
                {
                    <div class="menu-sep"></div>
                    <div class="menu-user-row" title="@Loc["menu.loggedInAsTitle"]">
                        <span class="menu-user-name">@CurrentUser.Username</span>
                        <button class="menu-item" title="@Loc["menu.logoutTitle"]" @onclick="Logout">@Loc["menu.logout"]</button>
                    </div>
                }
                <div class="menu-sep"></div>
                <span class="menu-version" title="@Loc["menu.versionTitle"]">@_version</span>
                <button class="menu-item" title="@Loc["menu.aboutTitle"]" @onclick="ShowAbout">@Loc["menu.about"]</button>
            </div>
        }
    </div>
</div>

<div class="app-body-row">
    <main class="app-main">
        @Body
    </main>
    @if (UiState.IndicatorsOpen && UiState.IndicatorsChannelName is not null)
    {
        <IndicatorsPanel ChannelName="@UiState.IndicatorsChannelName" OnClose="UiState.CloseIndicators" />
    }
</div>

@if (_aboutOpen)
{
    <div class="modal-overlay" @onclick="CloseAbout">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="about-header">
                <img src="icon.svg" width="48" height="48" alt="" />
                <h2>@Loc["about.title"]@(DevelopSuffix)</h2>
            </div>
            <p>@Loc["about.subtitle"]</p>
            <p>@Loc.T("about.version", _version)</p>
            <p class="about-copyright">© 2026 Роман Ермаков :: <a href="https://github.com/ykmn/quince-dotnet" target="_blank" rel="noopener">ykmn/quince-dotnet</a>
<br><br>
</p>
            <button class="btn btn-small" @onclick="CloseAbout">@Loc["common.close"]</button>
        </div>
    </div>
}

@if (UiState.EditDialogOpen)
{
    <ChannelEditDialog />
}

@if (UiState.DeleteTarget is not null)
{
    <DeleteChannelDialog Config="UiState.DeleteTarget" OnClose="UiState.CloseDeleteChannel" />
}

@if (UiState.CloneTarget is not null)
{
    <CloneChannelDialog Config="UiState.CloneTarget" OnClose="UiState.CloseCloneChannel" />
}

@if (UiState.SettingsOpen)
{
    <AppSettingsDialog OnClose="UiState.CloseSettings" />
}

@if (UiState.ReadmeOpen)
{
    <ReadmeDialog OnClose="UiState.CloseReadme" />
}

@if (UiState.BulkEditOpen)
{
    <BulkEditDialog />
}

<audio id="quince-playback-audio" style="display:none"></audio>

@code {
    [CascadingParameter] private CurrentUserContext? CurrentUser { get; set; }

    private bool _menuOpen;
    private bool _aboutOpen;
    private readonly string _version = "v" + VersionInfo.Version;

    /// <summary>" отладочная версия" when <see cref="Configuration.AppConfig.Develop"/> is set —
    /// lets whoever's running this instance tell a debug/test build apart from a normal production
    /// one at a glance (topbar brand, browser tab title, login page, About dialog all use this).</summary>
    private string DevelopSuffix => AppSettings.Current.Develop ? " отладочная версия" : "";

    // Theme is client-only (localStorage, applied pre-paint by the inline script in _Host.cshtml —
    // see theme.js) so the server can't know the real value until after first render; "light"
    // here is just the initial guess used before that JS round-trip lands.
    private string _theme = "light";

    // Braille "dots" spinner (same glyph set as common CLI spinners) shown in the status bar
    // between clicking ▶ (AudioPlaybackService.Play) and the browser <audio> element actually
    // starting to make sound — the gap is the PlayoutBuffer jitter buffer filling up.
    private static readonly string[] BrailleFrames = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"];
    private System.Threading.Timer? _bufferingTimer;
    private System.Diagnostics.Stopwatch? _bufferingStopwatch;
    private int _brailleIndex;
    private bool _buffering;
    private DotNetObjectReference<MainLayout>? _dotNetRef;

    protected override void OnInitialized()
    {
        UiState.Changed += OnUiStateChanged;
        Loc.Changed += OnUiStateChanged;
        PlaybackService.Changed += OnPlaybackChanged;
        _dotNetRef = DotNetObjectReference.Create(this);
    }

    private void OnUiStateChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _theme = await JS.InvokeAsync<string>("quinceTheme.get");
        StateHasChanged();
    }

    private Task ToggleTheme() => SetTheme(_theme == "dark" ? "light" : "dark");

    private async Task SetTheme(string theme)
    {
        if (_theme == theme) return;
        _theme = theme;
        await JS.InvokeVoidAsync("quinceTheme.set", theme);
    }

    private void ToggleTpIndicators() => SetShowTpIndicators(!AppSettings.Current.ShowTpIndicators);

    private void SetShowTpIndicators(bool show)
    {
        if (AppSettings.Current.ShowTpIndicators == show) return;
        // Mutates the live AppConfig in place rather than cloning it — Current is the same instance
        // AppSettings.Save expects back, so this is just flipping one field without having to copy
        // every other field (meter colors, ad/news keywords, ...) the way AppSettingsDialog.Save does
        // for its own full-form save.
        AppSettings.Current.ShowTpIndicators = show;
        AppSettings.Save(AppSettings.Current);
    }

    /// <summary>Drives the hidden &lt;audio&gt; element via JS interop whenever the monitored
    /// channel changes — the actual audio bytes come from <see cref="AudioStreamEndpoint"/>, this
    /// just points the element at (or away from) that URL. Playback always goes to the browser's
    /// current default output device (see playback.js for why device selection isn't available yet).</summary>
    private void OnPlaybackChanged()
    {
        var channel = PlaybackService.PlayingChannel;
        _ = InvokeAsync(async () =>
        {
            if (channel is null)
            {
                StopBufferingTimer();
                UiState.ClearStatusMessage();
                await JS.InvokeVoidAsync("quincePlayback.stop");
            }
            else
            {
                StartBuffering();
                await JS.InvokeVoidAsync("quincePlayback.play", $"/api/playback/stream/{Uri.EscapeDataString(channel)}", _dotNetRef);
            }
        });
    }

    private void StartBuffering()
    {
        _buffering = true;
        _brailleIndex = 0;
        _bufferingStopwatch = System.Diagnostics.Stopwatch.StartNew();
        UiState.SetStatusMessage(Loc.T("status.buffering", BrailleFrames[0], FormatBufferingRemaining()));
        _bufferingTimer?.Dispose();
        _bufferingTimer = new System.Threading.Timer(_ =>
        {
            _brailleIndex = (_brailleIndex + 1) % BrailleFrames.Length;
            _ = InvokeAsync(() =>
            {
                if (_buffering) UiState.SetStatusMessage(Loc.T("status.buffering", BrailleFrames[_brailleIndex], FormatBufferingRemaining()));
            });
        }, null, 120, 120);
    }

    // AppSettings.Current.PlayoutBufferSeconds is the target delay the jitter buffer banks before
    // releasing anything (see AppConfig.PlayoutBufferSeconds' own doc comment) — not an exact promise
    // of when sound appears, but close enough for a countdown the user can watch tick down to 0.
    private string FormatBufferingRemaining()
    {
        var total = AppSettings.Current.PlayoutBufferSeconds;
        var elapsed = _bufferingStopwatch?.Elapsed.TotalSeconds ?? 0;
        var remaining = Math.Max(0, total - elapsed);
        return remaining.ToString("F0", CultureInfo.InvariantCulture);
    }

    /// <summary>Stops the spinner's timer/flag only — does NOT touch the status message, since the
    /// two callers need different follow-up text: a persistent "Прослушка: X" once audio actually
    /// starts (<see cref="OnPlaybackStarted"/>) vs. clearing it outright once playback stops or fails
    /// (<see cref="OnPlaybackChanged"/>'s stop branch, <see cref="OnPlaybackError"/>).</summary>
    private void StopBufferingTimer()
    {
        if (!_buffering) return;
        _buffering = false;
        _bufferingTimer?.Dispose();
        _bufferingTimer = null;
        _bufferingStopwatch = null;
    }

    /// <summary>Called from playback.js when the &lt;audio&gt; element's "playing" event fires —
    /// the jitter buffer has enough data and sound is actually reaching the speakers now. Swaps the
    /// buffering spinner for a persistent "Прослушка: {channel}" status — deliberately NOT cleared
    /// automatically, so it stays visible for as long as listen-in is actually active instead of
    /// vanishing the moment playback starts.</summary>
    [JSInvokable]
    public void OnPlaybackStarted() => InvokeAsync(() =>
    {
        StopBufferingTimer();
        var channel = PlaybackService.PlayingChannel;
        if (channel != null) UiState.SetStatusMessage(Loc.T("status.listening", channel));
    });

    /// <summary>Called from playback.js on the &lt;audio&gt; element's "error" event, so a stream
    /// that never buffers (bad URL, source down) doesn't leave the spinner running forever.</summary>
    [JSInvokable]
    public void OnPlaybackError() => InvokeAsync(() =>
    {
        StopBufferingTimer();
        UiState.ClearStatusMessage();
    });

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;

    private void SetLanguage(string language)
    {
        try
        {
            Loc.SetLanguage(language);
        }
        catch (Exception ex)
        {
            // Same class of bug as the comment in ChannelEditDialog.Save(): an unhandled exception
            // here would escape the event handler and take down the whole Blazor Server circuit
            // (forcing a full browser reload) instead of just failing this one menu click.
            CloseMenu();
            UiState.SetStatusMessage(Loc.T("status.languageSaveError", ex.Message));
        }
    }

    private void ShowAbout()
    {
        _menuOpen = false;
        _aboutOpen = true;
    }

    private void CloseAbout() => _aboutOpen = false;

    private async Task Logout()
    {
        CloseMenu();
        await JS.InvokeVoidAsync("quinceAuth.logout");
    }

    private void NewChannel()
    {
        CloseMenu();
        UiState.OpenCreateChannel();
    }

    private void OpenSettings()
    {
        CloseMenu();
        UiState.OpenSettings();
    }

    private void RefreshConfig()
    {
        CloseMenu();
        var result = ChannelManager.Reload();
        UiState.SetStatusMessage(result.Error is not null
            ? Loc.T("status.configRefreshError", result.Error)
            : Loc.T("status.configRefreshed", result.Added, result.Updated, result.Removed));
    }

    private void ToggleBulkSelectMode()
    {
        UiState.ToggleBulkSelectMode();
        CloseMenu();
    }

    private void StartAll()
    {
        CloseMenu();
        var (started, eligible) = EngineManager.StartAll();
        UiState.SetStatusMessage(Loc.T("status.startedAll", started, eligible));
    }

    private void StopAll()
    {
        CloseMenu();
        var stopped = EngineManager.StopAll();
        UiState.SetStatusMessage(Loc.T("status.stoppedAll", stopped));
    }

    private void OpenReadme()
    {
        CloseMenu();
        UiState.OpenReadme();
    }

    public void Dispose()
    {
        UiState.Changed -= OnUiStateChanged;
        Loc.Changed -= OnUiStateChanged;
        PlaybackService.Changed -= OnPlaybackChanged;
        _bufferingTimer?.Dispose();
        _dotNetRef?.Dispose();
    }
}
