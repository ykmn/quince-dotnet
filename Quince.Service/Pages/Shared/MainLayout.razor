@inherits LayoutComponentBase

<div class="topbar">
    <div class="app-brand">
        <a class="app-brand-link" href="/">
            <img src="icon.svg" width="64" height="64" alt="" />
            <span class="app-name">Айва</span>
        </a>
    </div>
    <div class="hamburger-wrap">
        <button class="btn-hamburger" title="Меню" @onclick="ToggleMenu" @onclick:stopPropagation="true">☰</button>
        @if (_menuOpen)
        {
            <div class="menu-overlay" @onclick="CloseMenu"></div>
            <div class="hamburger-menu" @onclick:stopPropagation="true">
                <button class="menu-item" @onclick="CloseMenu">➕ Новый канал записи…</button>
                <div class="menu-sep"></div>
                <button class="menu-item" @onclick="CloseMenu">⚙️ Настройки…</button>
                <div class="menu-sep"></div>
                <button class="menu-item" @onclick="CloseMenu">🔄 Обновить конфигурацию</button>
                <button class="menu-item" @onclick="CloseMenu">🔁 Перезапуск приложения…</button>
                <div class="menu-sep"></div>
                <button class="menu-item" @onclick="CloseMenu">▶️ Запустить запись всех каналов</button>
                <button class="menu-item" @onclick="CloseMenu">⏹️ Остановить запись всех каналов</button>
                <div class="menu-sep"></div>
                <button class="menu-item" @onclick="CloseMenu">▦ Индикаторы уровней</button>
                <div class="menu-sep"></div>
                <button class="menu-item" @onclick="CloseMenu">📄 Показать файл README.md</button>
                <div class="menu-sep"></div>
                <span class="menu-version">@_version</span>
                <button class="menu-item" @onclick="ShowAbout">ℹ️ О программе…</button>
                <div class="menu-sep"></div>
                <button class="menu-item" @onclick="CloseMenu">🚪 Выход</button>
            </div>
        }
    </div>
</div>

<main>
    @Body
</main>

@if (_aboutOpen)
{
    <div class="modal-overlay" @onclick="CloseAbout">
        <div class="modal-box" @onclick:stopPropagation="true">
            <h2>Айва (Quince)</h2>
            <p>Многоканальный аудиологгер.</p>
            <p>Версия: @_version</p>
            <button class="btn btn-small" @onclick="CloseAbout">Закрыть</button>
        </div>
    </div>
}

@code {
    private bool _menuOpen;
    private bool _aboutOpen;
    private readonly string _version = "v" + VersionInfo.Version;

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;

    private void ShowAbout()
    {
        _menuOpen = false;
        _aboutOpen = true;
    }

    private void CloseAbout() => _aboutOpen = false;
}
