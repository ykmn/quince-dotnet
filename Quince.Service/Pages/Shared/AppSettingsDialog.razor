@using Microsoft.AspNetCore.Components
@using Quince.Service.Configuration
@using Quince.Service.Services
@inject AppSettingsService AppSettings

<div class="modal-overlay" @onclick="Close">
    <div class="modal-box" @onclick:stopPropagation="true">
        <h2>Настройки приложения</h2>

        <div class="form-grid">
            <label>Уровень логирования</label>
            <select @bind="_draft.LogLevel">
                <option value="DEBUG">DEBUG</option>
                <option value="INFO">INFO</option>
                <option value="WARNING">WARNING</option>
                <option value="ERROR">ERROR</option>
            </select>

            <label>Хранить логи, дней</label>
            <input type="number" @bind="_draft.LogRetentionDays" />

            <label>Порог жёлтой зоны, dBFS</label>
            <input type="number" step="0.1" @bind="_draft.MeterColors.ZoneYellowDb" />

            <label>Порог красной зоны, dBFS</label>
            <input type="number" step="0.1" @bind="_draft.MeterColors.ZoneRedDb" />

            <label>Цвет — зелёный</label>
            <input type="color" @bind="_draft.MeterColors.ColorGreen" />

            <label>Цвет — жёлтый</label>
            <input type="color" @bind="_draft.MeterColors.ColorYellow" />

            <label>Цвет — красный</label>
            <input type="color" @bind="_draft.MeterColors.ColorRed" />

            <label title="Устройство, на которое воспроизводится канал по кнопке ▶ на карточке канала.">Аудиовыход для прослушивания</label>
            <div class="input-with-button">
                <select value="@_draft.OutputDeviceUid" @onchange="OnDeviceSelected"
                        title="Устройство, на которое воспроизводится канал по кнопке ▶ на карточке канала.">
                    <option value="">— по умолчанию —</option>
                    @foreach (var d in _devices)
                    {
                        <option value="@d.Id">@d.Name@(d.IsDefault ? " (по умолчанию)" : "")</option>
                    }
                    @if (!string.IsNullOrEmpty(_draft.OutputDeviceUid) && !_devices.Any(d => d.Id == _draft.OutputDeviceUid))
                    {
                        <option value="@_draft.OutputDeviceUid">Текущее (не обнаружено сейчас)</option>
                    }
                </select>
                <button type="button" class="btn btn-small" @onclick="RefreshDevices" title="Обновить список устройств воспроизведения">🔄 Обновить</button>
            </div>
            @if (_deviceListError is not null)
            {
                <label></label>
                <div class="form-error">@_deviceListError</div>
            }

            <label title="Слова, при наличии которых в названии/исполнителе трека метаданные помечаются классом «C» (реклама) в CSV — независимо от регистра. Через запятую.">Слова-маркеры рекламы</label>
            <input @bind="_adKeywordsText" placeholder="Реклама, Reklama, Commercial"
                   title="Слова, при наличии которых в названии/исполнителе трека метаданные помечаются классом «C» (реклама) в CSV — независимо от регистра. Через запятую." />
        </div>

        <div class="form-actions">
            <button class="btn btn-small" @onclick="Close">Отмена</button>
            <button class="btn btn-start" @onclick="Save">Сохранить</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private AppConfig _draft = new();
    private List<Quince.Service.Audio.SoundcardCapture.RecordDeviceInfo> _devices = new();
    private string? _deviceListError;
    private string _adKeywordsText = "";

    protected override void OnInitialized()
    {
        var current = AppSettings.Current;
        _draft = new AppConfig
        {
            LogLevel = current.LogLevel,
            LogRetentionDays = current.LogRetentionDays,
            MeterColors = new MeterColorsConfig
            {
                ZoneYellowDb = current.MeterColors.ZoneYellowDb,
                ZoneRedDb = current.MeterColors.ZoneRedDb,
                ColorGreen = current.MeterColors.ColorGreen,
                ColorYellow = current.MeterColors.ColorYellow,
                ColorRed = current.MeterColors.ColorRed,
            },
            OutputDeviceUid = current.OutputDeviceUid,
        };
        _adKeywordsText = string.Join(", ", current.AdKeywords);
        RefreshDevices();
    }

    private void RefreshDevices()
    {
        try
        {
            _devices = AudioPlaybackService.EnumerateDevices();
            _deviceListError = null;
        }
        catch (System.Runtime.InteropServices.COMException ex)
        {
            _devices = new();
            _deviceListError = $"Не удалось опросить аудиоподсистему Windows (проверьте, что служба \"Windows Audio\" запущена): {ex.Message}";
        }
        catch (Exception ex)
        {
            _devices = new();
            _deviceListError = $"Не удалось получить список устройств воспроизведения: {ex.Message}";
        }
    }

    private void OnDeviceSelected(ChangeEventArgs e) => _draft.OutputDeviceUid = e.Value?.ToString() ?? "";

    private void Save()
    {
        _draft.AdKeywords = _adKeywordsText
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();
        AppSettings.Save(_draft);
        Close();
    }

    private void Close() => OnClose.InvokeAsync();
}
