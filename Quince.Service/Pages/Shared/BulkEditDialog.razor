@using Quince.Service.Configuration
@using Quince.Service.Services
@inject ChannelManager ChannelManager
@inject YamlConfigLoader Loader
@inject ChannelUiState UiState
@inject LocalizationService Loc

<div class="modal-overlay">
    <div class="modal-box modal-box-wide" @onclick:stopPropagation="true">
        <h2>@Loc.T("bulkEdit.title", UiState.SelectedChannelFilenames.Count)</h2>
        <p class="form-hint-neutral">@Loc["bulkEdit.hint"]</p>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="form-error">@_error</p>
        }

        <div class="form-grid">
            <label><input type="checkbox" @bind="_applyDateFolderFormat" /> @Loc["channelEdit.dateFolderLabel"]</label>
            <input @bind="_draft.DateFolderFormat" disabled="@(!_applyDateFolderFormat)" title="@Loc["channelEdit.dateFolderTitle"]" />

            <label><input type="checkbox" @bind="_applyFileNameFormat" /> @Loc["channelEdit.fileNameFormatLabel"]</label>
            <input @bind="_draft.FileNameFormat" disabled="@(!_applyFileNameFormat)" title="@Loc["channelEdit.fileNameFormatTitle"]" />

            <label><input type="checkbox" @bind="_applyFileDuration" /> @Loc["channelEdit.fileDurationLabel"]</label>
            <input type="number" @bind="_draft.FileDurationMinutes" disabled="@(!_applyFileDuration)" title="@Loc["channelEdit.fileDurationTitle"]" />

            <label><input type="checkbox" @bind="_applyRetention" /> @Loc["channelEdit.retentionLabel"]</label>
            <input type="number" @bind="_draft.RetentionDays" disabled="@(!_applyRetention)" title="@Loc["channelEdit.retentionTitle"]" />

            <label><input type="checkbox" @bind="_applyRecordAudio" /> @Loc["channelEdit.recordAudioLabel"]</label>
            <input type="checkbox" @bind="_draft.RecordAudio" disabled="@(!_applyRecordAudio)" title="@Loc["channelEdit.recordAudioTitle"]" />

            <label><input type="checkbox" @bind="_applyAutoStart" /> @Loc["channelEdit.autoStartLabel"]</label>
            <input type="checkbox" @bind="_draft.AutoStart" disabled="@(!_applyAutoStart)" title="@Loc["channelEdit.autoStartTitle"]" />

            <label><input type="checkbox" @bind="_applyOutputMode" /> @Loc["channelEdit.outputModeLabel"]</label>
            <select @bind="_draft.OutputFormat.Mode" disabled="@(!_applyOutputMode)" title="@Loc["channelEdit.outputModeTitle"]">
                <option value="original">@Loc["channelEdit.outputModeOriginal"]</option>
                <option value="custom">@Loc["channelEdit.outputModeCustom"]</option>
            </select>

            <label><input type="checkbox" @bind="_applySilenceEnabled" /> @Loc["channelEdit.silenceDetectorLabel"]</label>
            <input type="checkbox" @bind="_draft.SilenceDetector.Enabled" disabled="@(!_applySilenceEnabled)" title="@Loc["channelEdit.silenceDetectorTitle"]" />

            <label><input type="checkbox" @bind="_applyThreshold" /> @Loc["channelEdit.thresholdLabel"]</label>
            <input type="number" step="0.1" @bind="_draft.SilenceDetector.ThresholdDbfs" disabled="@(!_applyThreshold)" title="@Loc["channelEdit.thresholdTitle"]" />

            <label><input type="checkbox" @bind="_applyTrigger" /> @Loc["channelEdit.triggerLabel"]</label>
            <input type="number" step="0.1" @bind="_draft.SilenceDetector.TriggerSeconds" disabled="@(!_applyTrigger)" title="@Loc["channelEdit.triggerTitle"]" />

            <label><input type="checkbox" @bind="_applyResume" /> @Loc["channelEdit.resumeLabel"]</label>
            <input type="number" step="0.1" @bind="_draft.SilenceDetector.ResumeSeconds" disabled="@(!_applyResume)" title="@Loc["channelEdit.resumeTitle"]" />
        </div>

        <div class="form-actions">
            <button class="btn btn-small" @onclick="Close" disabled="@_saving">@Loc["common.cancel"]</button>
            <button class="btn btn-start" @onclick="Apply" disabled="@_saving">@(_saving ? Loc["channelEdit.saving"] : Loc["bulkEdit.apply"])</button>
        </div>
    </div>
</div>

@code {
    private readonly ChannelConfig _draft = new();
    private bool _saving;
    private string? _error;

    private bool _applyDateFolderFormat;
    private bool _applyFileNameFormat;
    private bool _applyFileDuration;
    private bool _applyRetention;
    private bool _applyRecordAudio;
    private bool _applyAutoStart;
    private bool _applyOutputMode;
    private bool _applySilenceEnabled;
    private bool _applyThreshold;
    private bool _applyTrigger;
    private bool _applyResume;

    private bool AnyFieldChecked =>
        _applyDateFolderFormat || _applyFileNameFormat || _applyFileDuration || _applyRetention ||
        _applyRecordAudio || _applyAutoStart || _applyOutputMode || _applySilenceEnabled ||
        _applyThreshold || _applyTrigger || _applyResume;

    private void Close() => UiState.CloseBulkEdit();

    private void Apply()
    {
        _error = null;
        if (!AnyFieldChecked)
        {
            _error = Loc["bulkEdit.errorNothingChecked"];
            return;
        }

        _saving = true;
        try
        {
            // Each channel gets its OWN existing config as the base (Loader.Clone), with only the
            // checked fields overwritten from _draft — everything else about that channel (source,
            // save path, name, ...) is untouched, same as a normal single-channel edit would leave it.
            foreach (var filename in UiState.SelectedChannelFilenames.ToList())
            {
                var existing = ChannelManager.Channels.FirstOrDefault(c => c.Filename == filename);
                if (existing is null) continue;
                var patched = Loader.Clone(existing);

                if (_applyDateFolderFormat) patched.DateFolderFormat = _draft.DateFolderFormat;
                if (_applyFileNameFormat) patched.FileNameFormat = _draft.FileNameFormat;
                if (_applyFileDuration) patched.FileDurationMinutes = _draft.FileDurationMinutes;
                if (_applyRetention) patched.RetentionDays = _draft.RetentionDays;
                if (_applyRecordAudio) patched.RecordAudio = _draft.RecordAudio;
                if (_applyAutoStart) patched.AutoStart = _draft.AutoStart;
                if (_applyOutputMode) patched.OutputFormat.Mode = _draft.OutputFormat.Mode;
                if (_applySilenceEnabled) patched.SilenceDetector.Enabled = _draft.SilenceDetector.Enabled;
                if (_applyThreshold) patched.SilenceDetector.ThresholdDbfs = _draft.SilenceDetector.ThresholdDbfs;
                if (_applyTrigger) patched.SilenceDetector.TriggerSeconds = _draft.SilenceDetector.TriggerSeconds;
                if (_applyResume) patched.SilenceDetector.ResumeSeconds = _draft.SilenceDetector.ResumeSeconds;

                ChannelManager.Update(filename, patched);
            }
        }
        catch (Exception ex)
        {
            // Same class of bug as ChannelEditDialog.Save()'s own comment — don't let an unhandled
            // exception here take down the whole Blazor Server circuit.
            _error = Loc.T("bulkEdit.errorSaveFailed", ex.Message);
            return;
        }
        finally
        {
            _saving = false;
        }

        UiState.EndBulkSelect();
    }
}
