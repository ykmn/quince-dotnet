@using Quince.Service.Configuration
@using Quince.Service.Services
@inject ChannelManager ChannelManager
@inject LocalizationService Loc

<div class="modal-overlay" @onclick="Close">
    <div class="modal-box" @onclick:stopPropagation="true">
        <h2>@Loc["delete.title"]</h2>
        <p>@Loc.T("delete.body", Config.Name, Config.Filename)</p>
        <div class="form-actions">
            <button class="btn btn-small" @onclick="Close">@Loc["common.cancel"]</button>
            <button class="btn btn-stop" @onclick="Confirm">@Loc["common.delete"]</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ChannelConfig Config { get; set; } = null!;
    [Parameter] public EventCallback OnClose { get; set; }

    private void Confirm()
    {
        ChannelManager.Delete(Config.Filename);
        Close();
    }

    private void Close() => OnClose.InvokeAsync();
}
